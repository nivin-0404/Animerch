---
/* @ts-nocheck */
import '../style/global.css';

import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
	'https://vvdrdzonanhxygaiviid.supabase.co',
	'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ2ZHJkem9uYW5oeHlnYWl2aWlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkzNjU1MjEsImV4cCI6MjA5NDk0MTUyMX0.rX97Rt41Hj5SLBQe6d1WqWddShgQ0lMZzIR1q9gUQ6M'
);

const { data: relatedProducts, error } = await supabase
	.from('Products')
	.select('*')
	.limit(3);

if (error) {
	console.error('Supabase error:', error);
}

const products = relatedProducts || [];

function getProductImages(product: any) {
	return [
		product.image,
		product.image2,
		product.image3,
		product.image4,
		product.image5,
		product.image_2,
		product.image_3,
		product.image_4,
		product.image_5
	]
		.filter(Boolean)
		.flatMap((value) => {
			return String(value)
				.split(/\n|,|\s+/)
				.map((url) => url.trim())
				.filter((url) => url.startsWith('http'));
		});
}
---

	<main class="cart-page">
		<h1>
			My Cart (
			<span id="cartCount">0</span>
			)
		</h1>

		<div id="cartItems" class="cart-items"></div>

		<section class="summary" aria-labelledby="summaryTitle">
			<h2 id="summaryTitle">
				Order Summary
			</h2>

			<div class="summary-box">
				<div class="row">
					<span>Order Subtotal</span>
					<span id="subtotal">0 kr</span>
				</div>

				<div class="row">
					<span>Estimated Shipping</span>
					<span>8.99 kr</span>
				</div>
			</div>

			<div class="total">
				<span>Total</span>
				<span id="total">0 kr</span>
			</div>

			<p class="tax-note">
				Shipping & taxes are calculated at checkout
			</p>

			<div class="checkout-buttons">
				<button class="checkout" type="button">
					Proceed to Checkout
				</button>

				<button class="gpay" type="button">
					G Pay Checkout
				</button>
			</div>
		</section>
	</main>

	<section class="related-products" aria-labelledby="relatedProductsTitle">
		<h2 id="relatedProductsTitle" data-i18n="relatedProducts">
			Related products
		</h2>

		<div class="related-grid">
			{
				products.map((product) => {
					const productImages = getProductImages(product);
					const image = productImages[0] || '/assets/ram.png';

					return (
						<div class="related-card">
							<div class="related-image">
								<a
									href={`/Productpage?id=${product.id}`}
									class="related-link"
								>
									<img src={image} alt={product.title} />
								</a>

								<button
									class="favorite related-wishlist"
									type="button"
									aria-label="Add to wishlist"
									data-id={product.id}
									data-title={product.title}
									data-price={product.price}
									data-image={image}
									data-badge={product.badge || ''}
								>
									♡
								</button>

								{product.badge && (
									<span class={`badge ${product.badge.toLowerCase()}`}>
										{product.badge}
									</span>
								)}
							</div>

							<div class="related-content">
								<a
									href={`/Productpage?id=${product.id}`}
									class="related-title-link"
								>
									<h3>
										{product.title}
									</h3>
								</a>

								<p class="price">
									{product.price} kr
								</p>

								<button
									class="related-cart-btn add-to-cart"
									type="button"
									data-id={product.id}
									data-title={product.title}
									data-price={product.price}
									data-image={image}
									data-badge={product.badge || ''}
									data-release-date={product.release_date || ''}
									data-i18n="addToCart"
								>
									Add to Cart
								</button>
							</div>
						</div>
					);
				})
			}
		</div>
	</section>

	<script is:inline>
		let cart = JSON.parse(localStorage.getItem('cart') || '[]');

		const cartItems = document.getElementById('cartItems');
		const cartCount = document.getElementById('cartCount');
		const subtotalEl = document.getElementById('subtotal');
		const totalEl = document.getElementById('total');

		const shipping = 8.99;

		function cleanImageUrl(image) {
			if (!image) return '/assets/ram.png';

			const imageUrl = String(image)
				.split(/\n|,|\s+/)
				.map((url) => url.trim())
				.find((url) => url.startsWith('http') || url.startsWith('/'));

			return imageUrl || '/assets/ram.png';
		}

		function getCart() {
			return JSON.parse(localStorage.getItem('cart') || '[]');
		}

		function saveCart() {
			localStorage.setItem('cart', JSON.stringify(cart));
		}

		function getWishlist() {
			return JSON.parse(localStorage.getItem('wishlist') || '[]');
		}

		function saveWishlist(wishlist) {
			localStorage.setItem('wishlist', JSON.stringify(wishlist));
		}

		function renderCart() {
			if (!cartItems) return;

			cart = getCart();
			cartItems.innerHTML = '';

			let subtotal = 0;

			if (cart.length === 0) {
				cartItems.innerHTML = `
					<p class="empty-cart">
						Your cart is empty.
					</p>
				`;
			}

			cart.forEach((item, index) => {
				const itemImage = cleanImageUrl(item.image);
				const itemName = item.name || 'Product';
				const itemPrice = Number(item.price) || 0;
				const itemQty = Number(item.qty) || 1;

				subtotal += itemPrice * itemQty;

				const div = document.createElement('div');

				div.className = 'cart-item';

				div.innerHTML = `
					<img src="${itemImage}" alt="${itemName}" />

					<div class="cart-info">
						${
							item.badge
								? `
									<span class="cart-badge">
										${item.badge}
									</span>
								`
								: ''
						}

						<h3>${itemName}</h3>

						<div class="qty-wrapper">
							<p>Quantity</p>

							<div class="qty">
								<button
									type="button"
									class="qty-btn"
									data-index="${index}"
									data-amount="-1"
								>
									-
								</button>

								<span>${itemQty}</span>

								<button
									type="button"
									class="qty-btn"
									data-index="${index}"
									data-amount="1"
								>
									+
								</button>
							</div>
						</div>

						${
							item.releaseDate
								? `
									<p class="release">
										Pre-Order release date:
										${item.releaseDate}
									</p>
								`
								: ''
						}

						<div class="cart-actions">
							<button
								class="link-btn move-wishlist-btn"
								type="button"
								data-index="${index}"
							>
								Move to Wishlist
							</button>

							<button
								class="link-btn remove-btn"
								type="button"
								data-index="${index}"
							>
								Remove
							</button>
						</div>
					</div>

					<p class="item-price">
						${itemPrice} kr
					</p>
				`;

				cartItems.appendChild(div);
			});

			if (cartCount) {
				cartCount.innerText = String(cart.length);
			}

			if (subtotalEl) {
				subtotalEl.innerText = `${subtotal.toFixed(2)} kr`;
			}

			if (totalEl) {
				const total = cart.length > 0 ? subtotal + shipping : 0;
				totalEl.innerText = `${total.toFixed(2)} kr`;
			}

			setupCartButtons();
		}

		function setupCartButtons() {
			const qtyButtons = document.querySelectorAll('.qty-btn');
			const removeButtons = document.querySelectorAll('.remove-btn');
			const moveWishlistButtons = document.querySelectorAll('.move-wishlist-btn');

			qtyButtons.forEach((button) => {
				button.addEventListener('click', () => {
					const index = Number(button.dataset.index);
					const amount = Number(button.dataset.amount);

					cart[index].qty += amount;

					if (cart[index].qty <= 0) {
						cart.splice(index, 1);
					}

					saveCart();
					renderCart();
				});
			});

			removeButtons.forEach((button) => {
				button.addEventListener('click', () => {
					const index = Number(button.dataset.index);

					cart.splice(index, 1);

					saveCart();
					renderCart();
				});
			});

			moveWishlistButtons.forEach((button) => {
				button.addEventListener('click', () => {
					const index = Number(button.dataset.index);
					const item = cart[index];

					let wishlist = getWishlist();

					const product = {
						id: item.id,
						name: item.name,
						price: Number(item.price),
						image: cleanImageUrl(item.image),
						badge: item.badge || ''
					};

					const alreadyExists = wishlist.find((wishlistItem) => {
						return String(wishlistItem.id) === String(product.id);
					});

					if (!alreadyExists) {
						wishlist.push(product);
					}

					saveWishlist(wishlist);

					cart.splice(index, 1);

					saveCart();
					renderCart();
					setupWishlistButtons();
				});
			});
		}

		function setupAddToCartButtons() {
			const buttons = document.querySelectorAll('.add-to-cart');

			buttons.forEach((button) => {
				button.addEventListener('click', () => {
					const product = {
						id: button.dataset.id,
						name: button.dataset.title,
						price: Number(button.dataset.price),
						image: cleanImageUrl(button.dataset.image),
						badge: button.dataset.badge || '',
						releaseDate: button.dataset.releaseDate || '',
						qty: 1
					};

					const existingProduct = cart.find((item) => {
						return String(item.id) === String(product.id);
					});

					if (existingProduct) {
						existingProduct.qty += 1;
					} else {
						cart.push(product);
					}

					saveCart();
					renderCart();

					button.innerText = 'Added ✓';

					setTimeout(() => {
						button.innerText = 'Add to Cart';
					}, 1000);
				});
			});
		}

		function setupWishlistButtons() {
			const wishlistButtons = document.querySelectorAll('.related-wishlist');
			const wishlist = getWishlist();

			wishlistButtons.forEach((button) => {
				const alreadyExists = wishlist.find((item) => {
					return String(item.id) === String(button.dataset.id);
				});

				if (alreadyExists) {
					button.innerText = '♥';
					button.classList.add('active');
					button.setAttribute('aria-label', 'Remove from wishlist');
				} else {
					button.innerText = '♡';
					button.classList.remove('active');
					button.setAttribute('aria-label', 'Add to wishlist');
				}

				button.addEventListener('click', (event) => {
					event.preventDefault();
					event.stopPropagation();

					let wishlist = getWishlist();

					const product = {
						id: button.dataset.id,
						name: button.dataset.title,
						price: Number(button.dataset.price),
						image: cleanImageUrl(button.dataset.image),
						badge: button.dataset.badge || ''
					};

					const alreadyExists = wishlist.find((item) => {
						return String(item.id) === String(product.id);
					});

					if (!alreadyExists) {
						wishlist.push(product);

						button.innerText = '♥';
						button.classList.add('active');
						button.setAttribute('aria-label', 'Remove from wishlist');
					} else {
						wishlist = wishlist.filter((item) => {
							return String(item.id) !== String(product.id);
						});

						button.innerText = '♡';
						button.classList.remove('active');
						button.setAttribute('aria-label', 'Add to wishlist');
					}

					saveWishlist(wishlist);
				});
			});
		}

		setupAddToCartButtons();
		setupWishlistButtons();
		renderCart();
	</script>

<style is:global>
:root {
	--pink: #ef4f96;
	--light-pink: #f8b8da;
	--purple: #4c2366;
	--bg: #ffffff;
	--line: #cfa8e6;
	--tax-pink: #f4a9ce;
}

body {
	background: var(--bg);
	color: var(--purple);
}

/* CART PAGE */

.cart-page {
	width: 100%;
	max-width: 1200px;

	margin: 0 auto;
	padding: 3rem 2rem;
}

.cart-page h1 {
	margin-bottom: 2rem;

	font-size: 2.2rem;
	font-weight: 700;
	letter-spacing: -0.02em;
}

.cart-items {
	display: flex;
	flex-direction: column;

	border-top: 1px solid var(--line);
}

.empty-cart {
	padding: 2rem 0;

	color: var(--purple);

	font-size: 1.1rem;
}

/* CART ITEM */

.cart-item {
	display: grid;
	grid-template-columns: 190px minmax(0, 1fr) auto;
	align-items: flex-start;
	gap: 2rem;

	padding: 2rem 0;

	border-bottom: 1px solid var(--line);
}

.cart-item img {
	width: 190px;
	height: 190px;

	padding: 1rem;

	background: #efcfc8;
	border-radius: 12px;

	object-fit: contain;
	flex-shrink: 0;
}

.cart-info {
	min-width: 0;

	display: flex;
	flex-direction: column;
}

.cart-badge {
	width: fit-content;

	margin-bottom: 1rem;
	padding: 0.35rem 0.9rem;

	background: var(--pink);
	color: white;

	border-radius: 6px;

	font-size: 0.75rem;
	font-weight: 800;
	letter-spacing: 0.03em;
}

.cart-info h3 {
	margin-bottom: 1.2rem;

	font-size: 1.05rem;
	font-weight: 500;
	line-height: 1.4;
}

.qty-wrapper {
	display: flex;
	align-items: center;
	gap: 1.5rem;

	margin-bottom: 1.2rem;
}

.qty-wrapper p {
	font-size: 0.95rem;
}

.qty {
	display: flex;
	align-items: center;
	gap: 1.2rem;

	padding: 0.2rem 0.7rem;

	border: 1px solid var(--pink);
	border-radius: 8px;
}

.qty button {
	border: none;

	background: transparent;
	color: var(--pink);

	font-size: 1.1rem;

	cursor: pointer;
}

.qty span {
	min-width: 15px;

	text-align: center;
	font-size: 0.95rem;
	font-weight: 700;
}

.release {
	margin-bottom: 2.5rem;

	color: #ff0000;

	font-size: 0.95rem;
	font-weight: 700;
}

.cart-actions {
	display: flex;
	gap: 2.5rem;

	margin-top: auto;
}

.link-btn {
	border: none;

	background: none;
	color: var(--purple);

	text-decoration: underline;
	font-size: 0.95rem;

	cursor: pointer;
}

.item-price {
	margin-left: auto;

	font-size: 1rem;
	font-weight: 700;
	white-space: nowrap;
}

/* SUMMARY */

.summary {
	margin-top: 3rem;
}

.summary h2 {
	margin-bottom: 1.5rem;

	font-size: 1.8rem;
	font-weight: 700;
}

.summary-box {
	display: flex;
	flex-direction: column;
}

.summary .row {
	display: flex;
	justify-content: space-between;
	gap: 1rem;

	padding: 1.2rem 0;

	border-bottom: 1px solid var(--line);

	font-size: 1rem;
}

.summary .total {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;

	margin-top: 0.5rem;
	padding-top: 2rem;
}

.summary .total span {
	font-size: 1.8rem;
	font-weight: 700;
}

.tax-note {
	margin-top: 0.4rem;

	color: var(--tax-pink);

	font-size: 0.9rem;
}

.checkout-buttons {
	display: flex;
	gap: 1.5rem;

	margin-top: 3rem;
}

.checkout,
.gpay {
	flex: 1;

	padding: 1.1rem;

	border: none;
	border-radius: 10px;

	background: var(--pink);
	color: white;

	font-size: 1rem;
	font-weight: 700;

	cursor: pointer;
}

.gpay {
	background: #111;
}

/* RELATED PRODUCTS */

.related-products {
	width: 100%;
	max-width: 1400px;

	margin: 0 auto;
	padding: 5rem 2rem;

	background: #ffffff;
}

.related-products h2 {
	margin-bottom: 3rem;

	color: var(--purple);

	text-align: center;
	font-size: 2rem;
}

.related-grid {
	width: 100%;

	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 2rem;

	margin: 0 auto;
}

.related-card {
	width: 100%;
	min-width: 0;

	display: flex;
	flex-direction: column;
}

.related-image {
	position: relative;

	aspect-ratio: 1 / 1;

	display: flex;
	align-items: center;
	justify-content: center;

	padding: 2rem;

	background: #efc9cb;
	border-radius: 20px;

	overflow: hidden;
}

.related-link {
	width: 100%;
	height: 100%;

	display: flex;
	align-items: center;
	justify-content: center;

	color: inherit;
	text-decoration: none;
}

.related-image img {
	width: 100%;
	height: 100%;

	display: block;
	padding: 0;

	object-fit: contain;
	box-sizing: border-box;
}

/* FAVORITE */

.favorite {
	position: absolute;
	top: 1rem;
	right: 1rem;
	z-index: 10;

	width: 50px;
	height: 50px;

	display: flex;
	align-items: center;
	justify-content: center;

	border: none;
	border-radius: 50%;

	background: #ffffff;
	color: var(--pink);

	font-size: 1.35rem;
	font-weight: 700;
	line-height: 1;

	cursor: pointer;
	transition: 0.2s ease;
}

.favorite:hover {
	transform: scale(1.05);
}

.favorite.active {
	background: var(--pink) !important;
	color: #ffffff !important;
}

/* BADGES */

.badge {
	position: absolute;
	left: 1.25rem;
	bottom: 1.25rem;
	z-index: 4;

	padding: 1rem 2rem;

	border-radius: 14px;

	color: white;

	font-size: 1rem;
	font-weight: bold;
}

.sale {
	background: #f4c542;
	color: #4c2366;
}

.preorder,
.pre-order {
	background: #ff5ca8;
}

.new {
	background: #8d5bc5;
}

/* RELATED CONTENT */

.related-content {
	padding-top: 1rem;
}

.related-title-link {
	color: inherit;
	text-decoration: none;
}

.related-title-link h3 {
	min-height: 3rem;
	margin-bottom: 0.5rem;

	color: #4c2366;

	font-size: 1rem;
	line-height: 1.5;

	cursor: pointer;

	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
}

.related-title-link h3:hover {
	color: var(--pink);
}

.related-content .price {
	margin-bottom: 1rem;

	color: #4c2366;

	font-size: 1.3rem;
	font-weight: 700;
}

.related-cart-btn {
	width: 100%;

	padding: 1rem 3rem;

	border: none;
	border-radius: 999px;

	background: #e5a8da;
	color: #4c2366;

	font-size: 1rem;
	font-weight: 600;

	cursor: pointer;
	box-shadow: none;
	transition: 0.25s ease;
}

.related-cart-btn:hover {
	transform: translateY(-2px);
	opacity: 0.95;
}

/* TABLET */

@media (max-width: 1000px) {
	.cart-item {
		grid-template-columns: 160px minmax(0, 1fr) auto;
		gap: 1.5rem;
	}

	.cart-item img {
		width: 160px;
		height: 160px;
	}

	.related-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
}

/* MOBILE */

@media (max-width: 700px) {
	.cart-page {
		padding: 2rem 1rem;
	}

	.cart-page h1 {
		font-size: 1.8rem;
		margin-bottom: 1.5rem;
	}

	.cart-item {
		grid-template-columns: 120px minmax(0, 1fr);
		gap: 1rem;

		padding: 1.5rem 0;
	}

	.cart-item img {
		width: 120px;
		height: 120px;
		padding: 0.75rem;
	}

	.cart-info h3 {
		font-size: 0.95rem;
		margin-bottom: 1rem;
	}

	.qty-wrapper {
		align-items: flex-start;
		flex-direction: column;
		gap: 0.5rem;

		margin-bottom: 1rem;
	}

	.qty {
		width: fit-content;
		gap: 1rem;
	}

	.cart-actions {
		flex-wrap: wrap;
		gap: 1rem;
	}

	.link-btn {
		font-size: 0.9rem;
	}

	.item-price {
		grid-column: 2;
		margin-left: 0;

		font-size: 0.95rem;
	}

	.summary {
		margin-top: 2.5rem;
	}

	.summary h2 {
		font-size: 1.5rem;
	}

	.summary .row {
		font-size: 0.95rem;
	}

	.summary .total span {
		font-size: 1.5rem;
	}

	.checkout-buttons {
		flex-direction: column;
		gap: 1rem;

		margin-top: 2rem;
	}

	.checkout,
	.gpay {
		width: 100%;
		padding: 1rem;
	}

	.related-products {
		padding: 3rem 1rem;
	}

	.related-products h2 {
		font-size: 1.6rem;
		margin-bottom: 2rem;
	}

	.related-grid {
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.related-card {
		max-width: 420px;
		margin: 0 auto;
	}

	.related-image {
		padding: 1.5rem;
		border-radius: 18px;
	}

	.favorite {
		top: 0.8rem;
		right: 0.8rem;

