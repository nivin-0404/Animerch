---
const title = "My Cart";
---

<html lang="en">
<head>
	<meta charset="UTF-8" />

	<meta
		name="viewport"
		content="width=device-width, initial-scale=1.0"
	/>

	<title>{title}</title>
</head>

<body>

<main class="cart-page">

	<h1>
		My Cart (
		<span id="cartCount">0</span>
		)
	</h1>

	<div
		id="cartItems"
		class="cart-items"
	></div>

	<div class="summary">

		<h2>Order Summary</h2>

		<div class="summary-box">

			<div class="row">
				<span>Order Subtotal</span>

				<span id="subtotal">
					$0.00
				</span>
			</div>

			<div class="row">
				<span>
					Estimated Shipping
				</span>

				<span>$8.99</span>
			</div>

		</div>

		<div class="total">

			<span>Total</span>

			<span id="total">
				$0.00
			</span>

		</div>

		<p class="tax-note">
			Shipping & taxes are
			calculated at checkout
		</p>

		<div class="checkout-buttons">

			<button class="checkout">
				Proceed to Checkout
			</button>

			<button class="gpay">
				G Pay Checkout
			</button>

		</div>

	</div>

</main>

<section class="related-products">

	<h2>Related products</h2>

	<div class="related-grid">

		<div class="related-card">

			<div class="related-image">

				<img
					src="/assets/ram.png"
					alt="Anime Figure"
				/>

				<button class="favorite">
					♡
				</button>

			</div>

			<div class="related-content">

				<h3>
					Lorem ipsum dolor sit amet
				</h3>

				<p class="price">
					29.99 $
				</p>

				<button class="related-cart-btn">
					Add to Cart
				</button>

			</div>

		</div>

		<div class="related-card">

			<div class="related-image">

				<img
					src="/assets/ram.png"
					alt="Anime Figure"
				/>

				<button class="favorite">
					♡
				</button>

				<span class="badge sale">
					SALE
				</span>

			</div>

			<div class="related-content">

				<h3>
					Lorem ipsum dolor sit amet
				</h3>

				<p class="price">
					29.99 $
				</p>

				<button class="related-cart-btn">
					Add to Cart
				</button>

			</div>

		</div>

		<div class="related-card">

			<div class="related-image">

				<img
					src="/assets/ram.png"
					alt="Anime Figure"
				/>

				<button class="favorite">
					♡
				</button>

				<span class="badge preorder">
					PRE-ORDER
				</span>

			</div>

			<div class="related-content">

				<h3>
					Lorem ipsum dolor sit amet
				</h3>

				<p class="price">
					29.99 $
				</p>

				<button class="related-cart-btn">
					Add to Cart
				</button>

			</div>

		</div>

	</div>

</section>

<script is:inline>
	let cart = JSON.parse(
		localStorage.getItem('cart') || '[]'
	);

	const cartItems =
		document.getElementById(
			'cartItems'
		);

	const cartCount =
		document.getElementById(
			'cartCount'
		);

	const subtotalEl =
		document.getElementById(
			'subtotal'
		);

	const totalEl =
		document.getElementById(
			'total'
		);

	function saveCart() {
		localStorage.setItem(
			'cart',
			JSON.stringify(cart)
		);
	}

	function renderCart() {
		if (!cartItems) return;

		cartItems.innerHTML = '';

		let subtotal = 0;

		cart.forEach((item, index) => {
			subtotal +=
				item.price * item.qty;

			const div =
				document.createElement(
					'div'
				);

			div.className =
				'cart-item';

			div.innerHTML = `
				<img src="${item.image}" />

				<div class="cart-info">

					<span class="cart-badge">
						PRE-ORDER
					</span>

					<h3>${item.name}</h3>

					<div class="qty-wrapper">

						<p>Quantity</p>

						<div class="qty">
							<button onclick="changeQty(${index}, -1)">
								-
							</button>

							<span>${item.qty}</span>

							<button onclick="changeQty(${index}, 1)">
								+
							</button>
						</div>

					</div>

					<p class="release">
						Pre-Order release date:
						01/01/2027
					</p>

					<div class="cart-actions">

						<button class="link-btn">
							Move to Wishlist
						</button>

						<button
							class="link-btn"
							onclick="removeItem(${index})"
						>
							Remove
						</button>

					</div>

				</div>

				<p class="item-price">
					$${item.price}
				</p>
			`;

			cartItems.appendChild(div);
		});

		if (cartCount) {
			cartCount.innerText =
				String(cart.length);
		}

		if (subtotalEl) {
			subtotalEl.innerText =
				`$${subtotal.toFixed(2)}`;
		}

		if (totalEl) {
			totalEl.innerText =
				`$${(
					subtotal + 8.99
				).toFixed(2)}`;
		}
	}

	function changeQty(index, amount) {
		cart[index].qty += amount;

		if (cart[index].qty <= 0) {
			cart.splice(index, 1);
		}

		saveCart();
		renderCart();
	}

	function removeItem(index) {
		cart.splice(index, 1);

		saveCart();
		renderCart();
	}

	renderCart();
</script>

</body>
</html>

<style>
	:root {
		--pink: #ef4f96;
		--light-pink: #f8b8da;
		--purple: #4c2366;
		--bg: #ffffff; 
		--line: #cfa8e6;
		--tax-pink: #f4a9ce; 
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	body {
		background: var(--bg);
		font-family: Inter, sans-serif;
		color: var(--purple);
		-webkit-font-smoothing: antialiased;
	}

	/* PAGE LAYOUT */
	.cart-page {
		max-width: 1200px;
		margin: auto;
		padding: 3rem 2rem;
	}

	/* TITLE */
	.cart-page h1 {
		font-size: 2.2rem;
		font-weight: 700;
		margin-bottom: 2rem;
		letter-spacing: -0.02em;
	}

	/* CART CONTAINER & DYNAMIC ITEMS */
	.cart-items {
		border-top: 1px solid var(--line);
		display: flex;
		flex-direction: column;
	}

	/* RELATED PRODUCTS */

.related-products {
	padding: 5rem 2rem;
}

.related-products h2 {
	text-align: center;
	font-size: 2rem;
	margin-bottom: 3rem;
	color: var(--purple);
}

/* GRID */

.related-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 2rem;
}

/* CARD */

.related-card {
	display: flex;
	flex-direction: column;
}

/* IMAGE */

.related-image {
	position: relative;
	background: #efc9cb;
	border-radius: 20px;

	display: flex;
	align-items: center;
	justify-content: center;

	overflow: hidden;
}

.related-image img {
	width: 72%;
	object-fit: contain;
}

/* HEART */

.favorite {
	position: absolute;
	top: 1rem;
	right: 1rem;

	width: 50px;
	height: 50px;

	border-radius: 50%;
	border: none;

	background: white;
	color: var(--pink);

	font-size: 1.5rem;
	cursor: pointer;
}

/* BADGES */

.badge {
	position: absolute;
	left: 1rem;
	bottom: 1rem;

	padding: 0.8rem 1.5rem;
	border-radius: 10px;

	color: white;
	font-weight: bold;
	font-size: 0.9rem;
}

.sale {
	background: #f3c93c;
}

.preorder {
	background: var(--pink);
}

/* CONTENT */

.related-content {
	padding-top: 1rem;
}

.related-content h3 {
	font-size: 1rem;
	margin-bottom: 0.5rem;
	color: var(--purple);
	font-weight: 500;
}

.related-content .price {
	font-size: 1.2rem;
	margin-bottom: 1rem;
	font-weight: 600;
}

/* BUTTON */

.related-cart-btn {
	width: 100%;

	border: none;
	border-radius: 999px;

	background: #e8a9df;
	color: var(--purple);

	padding: 1rem;

	font-size: 1rem;
	font-weight: 600;

	cursor: pointer;

	transition: 0.2s ease;
}

.related-cart-btn:hover {
	transform: translateY(-2px);
	opacity: 0.95;
}

/* MOBILE */

@media (max-width: 950px) {

	.related-grid {
		grid-template-columns: 1fr;
	}
}

	/* NOTE: Since your Astro template generates items dynamically via JS inside #cartItems,
	   the classes below target the markup your JavaScript should inject.
	*/
	:global(.cart-item) {
		display: flex;
		align-items: flex-start;
		gap: 2rem;
		padding: 2rem 0;
		border-bottom: 1px solid var(--line);
	}

	:global(.cart-item img) {
		width: 190px;
		height: 190px;
		object-fit: cover;
		border-radius: 8px;
		flex-shrink: 0;
	}

	:global(.cart-info) {
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	:global(.cart-badge) {
		background: var(--pink);
		color: white;
		font-size: 0.75rem;
		font-weight: 800;
		padding: 0.35rem 0.9rem;
		border-radius: 6px;
		width: fit-content;
		margin-bottom: 1rem;
		letter-spacing: 0.03em;
	}

	:global(.cart-info h3) {
		font-size: 1.05rem;
		font-weight: 500;
		line-height: 1.4;
		margin-bottom: 1.2rem;
	}

	:global(.qty-wrapper) {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 1.2rem;
	}

	:global(.qty-wrapper p) {
		font-size: 0.95rem;
	}

	:global(.qty) {
		display: flex;
		align-items: center;
		gap: 1.2rem;
		border: 1px solid var(--pink);
		border-radius: 8px;
		padding: 0.2rem 0.7rem;
	}

	:global(.qty button) {
		background: transparent;
		border: none;
		font-size: 1.1rem;
		color: var(--pink);
		cursor: pointer;
	}

	:global(.qty span) {
		font-size: 0.95rem;
		font-weight: 700;
		min-width: 15px;
		text-align: center;
	}

	:global(.release) {
		color: #ff0000;
		font-size: 0.95rem;
		font-weight: 700;
		margin-bottom: 2.5rem;
	}

	:global(.cart-actions) {
		display: flex;
		gap: 2.5rem;
	}

	:global(.link-btn) {
		background: none;
		border: none;
		text-decoration: underline;
		color: var(--purple);
		font-size: 0.95rem;
		cursor: pointer;
	}

	:global(.item-price) {
		font-size: 1rem;
		font-weight: 400;
		margin-left: auto;
		white-space: nowrap;
	}


	/* ORDER SUMMARY */
	.summary {
		margin-top: 3rem;
	}

	.summary h2 {
		font-size: 1.8rem;
		font-weight: 700;
		margin-bottom: 1.5rem;
	}

	.summary-box {
		display: flex;
		flex-direction: column;
	}

	.summary .row {
		display: flex;
		justify-content: space-between;
		padding: 1.2rem 0;
		font-size: 1rem;
		border-bottom: 1px solid var(--line);
	}

	/* TOTAL SECTION */
	.summary .total {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 2rem;
		margin-top: 0.5rem;
	}

	.summary .total span {
		font-size: 1.8rem;
		font-weight: 700;
	}

	/* TAX NOTE */
	.tax-note {
		font-size: 0.9rem;
		color: var(--tax-pink);
		margin-top: 0.4rem;
	}

	/* BUTTON CONTAINER */
	.checkout-buttons {
		display: flex;
		gap: 1.5rem;
		margin-top: 3rem;
	}

	/* BUTTON BASICS */
	.checkout, .gpay {
		flex: 1;
		padding: 1.1rem;
		border: none;
		border-radius: 10px
		background: var(--pink);