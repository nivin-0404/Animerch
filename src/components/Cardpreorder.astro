---
/* @ts-nocheck */

import '../style/global.css';
import { createClient } from '@supabase/supabase-js'

const supabase = createClient(
	'https://vvdrdzonanhxygaiviid.supabase.co',
	'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ2ZHJkem9uYW5oeHlnYWl2aWlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkzNjU1MjEsImV4cCI6MjA5NDk0MTUyMX0.rX97Rt41Hj5SLBQe6d1WqWddShgQ0lMZzIR1q9gUQ6M'
)

const { data: products, error } = await supabase
	.from('Products')
	.select('*')

if (error) {
	console.error('Supabase error:', error)
}

const preorderProducts = products?.filter((product) => {
	return product.badge === 'PRE-ORDER'
})
---

<section class="featured pre-order-section">
	<div class="section-header">
		<h2 data-i18n="preOrders">Pre-Orders</h2>

		<a href="/Collectionspage" data-i18n="shopMore">
			Shop more ›
		</a>
	</div>

	<div class="card-grid">
		{
			preorderProducts?.slice(0, 3).map((product: any) => (
				<div class="card">
					<div class="card-image">
<a
	href={`/Productpage?id=${product.id}`}
	class="product-image-link"
>
	<img
		src={product.image || '/assets/ram.png'}
		alt={product.title}
	/>
</a>

						<button
							class="favorite pre-order-wishlist"
							type="button"
							data-id={product.id}
							data-title={product.title}
							data-price={product.price}
							data-image={product.image || '/assets/ram.png'}
							data-badge={product.badge || ''}
						>
							♡
						</button>

						{product.badge && (
							<span class={`badge ${product.badge.toLowerCase()}`}>
								{product.badge}
							</span>
						)}
					</div>

					<div class="card-content">
<a
	href={`/Productpage?id=${product.id}`}
	class="product-title-link"
>
	<h3>{product.title}</h3>
</a>

						<p class="price">
							{product.price} kr
						</p>

						<button
							class="cart-btn pre-order-cart"
							type="button"
							data-id={product.id}
							data-title={product.title}
							data-price={product.price}
							data-image={product.image || '/assets/ram.png'}
							data-badge={product.badge || ''}
							data-release-date={product.release_date || ''}
							data-i18n="addToCart"
						>
							Add to Cart
						</button>
					</div>
				</div>
			))
		}
	</div>
</section>

<script is:inline>
(() => {
	const cartButtons = document.querySelectorAll('.pre-order-cart');

	cartButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const product = {
				id: button.dataset.id,
				name: button.dataset.title,
				price: Number(button.dataset.price),
				image: button.dataset.image,
				badge: button.dataset.badge || '',
				releaseDate: button.dataset.releaseDate || '',
				qty: 1
			};

			const cart = JSON.parse(
				localStorage.getItem('cart') || '[]'
			);

			const existingProduct = cart.find(
				(item) => String(item.id) === String(product.id)
			);

			if (existingProduct) {
				existingProduct.qty += 1;
			} else {
				cart.push(product);
			}

			localStorage.setItem(
				'cart',
				JSON.stringify(cart)
			);

			button.innerText = 'Added ✓';

			setTimeout(() => {
				button.innerText = 'Add to Cart';
			}, 1000);
		});
	});

	const wishlistButtons = document.querySelectorAll('.pre-order-wishlist');

	function loadWishlistState() {
		const wishlist = JSON.parse(
			localStorage.getItem('wishlist') || '[]'
		);

		wishlistButtons.forEach((button) => {
			const productId = button.dataset.id;

			const alreadyExists = wishlist.find(
				(item) => String(item.id) === String(productId)
			);

			if (alreadyExists) {
				button.innerText = '♥';
				button.classList.add('active');
			}
		});
	}

	wishlistButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const product = {
				id: button.dataset.id,
				name: button.dataset.title,
				price: Number(button.dataset.price),
				image: button.dataset.image,
				badge: button.dataset.badge || ''
			};

			let wishlist = JSON.parse(
				localStorage.getItem('wishlist') || '[]'
			);

			const alreadyExists = wishlist.find(
				(item) => String(item.id) === String(product.id)
			);

			if (!alreadyExists) {
				wishlist.push(product);

				localStorage.setItem(
					'wishlist',
					JSON.stringify(wishlist)
				);

				button.innerText = '♥';
				button.classList.add('active');
			} else {
				wishlist = wishlist.filter(
					(item) => String(item.id) !== String(product.id)
				);

				localStorage.setItem(
					'wishlist',
					JSON.stringify(wishlist)
				);

				button.innerText = '♡';
				button.classList.remove('active');
			}
		});
	});

	loadWishlistState();
})();
</script>

<style>
.featured {
	padding: 5rem;
	background: #f5f5f5;
}

.section-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 2rem;
}

.section-header h2 {
	font-size: 2rem;
	color: #4c2366;
}

.section-header a {
	text-decoration: none;
	color: #4c2366;
}

.card-grid {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 2rem;
}

.card-image {
	position: relative;
	background: #efcfc8;
	border-radius: 20px;
	padding: 2rem;

	aspect-ratio: 1 / 1;

	display: flex;
	align-items: center;
	justify-content: center;

	overflow: hidden;
}

.product-image-link {
	width: 100%;
	height: 100%;

	display: flex;
	align-items: center;
	justify-content: center;

	text-decoration: none;
	color: inherit;
}

.card-image img {
	width: 100%;
	height: 100%;
	object-fit: contain;
	display: block;
}

.favorite {
	position: absolute;
	top: 1rem;
	right: 1rem;

	width: 50px;
	height: 50px;

	border-radius: 50%;
	border: none;

	background: white;
	color: #ef4f96;

	font-size: 1.5rem;
	cursor: pointer;
	z-index: 5;
}

.favorite.active {
	background: #ef4f96;
	color: white;
}

.badge {
	position: absolute;
	left: 1.25rem;
	bottom: 1.25rem;

	color: white;

	padding: 1rem 2rem;
	border-radius: 14px;

	font-weight: bold;
	font-size: 1rem;

	z-index: 4;
}

.badge.new {
	background: #8d5bc5;
}

.badge.sale {
	background: #f4c542;
	color: #4c2366;
}

.badge.pre-order {
	background: #ff5ca8;
}

.card-content {
	padding-top: 1rem;
}

.product-title-link {
	text-decoration: none;
	color: inherit;
}

.product-title-link h3 {
	font-size: 1rem;
	color: #4c2366;
	margin-bottom: 0.5rem;
	cursor: pointer;
}

.product-title-link h3:hover {
	color: #ef4f96;
}

.price {
	font-size: 1.3rem;
	font-weight: 700;
	color: #4c2366;
	margin-bottom: 1rem;
}

.cart-btn {
	width: 100%;
	padding: 1rem;
	border: none;
	border-radius: 999px;
	background: #e5a8da;
	color: #4c2366;
	font-size: 1rem;
	cursor: pointer;
	transition: 0.2s ease;
}

.cart-btn:hover {
	transform: translateY(-2px);
	opacity: 0.9;
}

@media (max-width: 1024px) {
	.card-grid {
		grid-template-columns: repeat(2, 1fr);
	}
}

@media (max-width: 640px) {
	.featured {
		padding: 3rem 2rem;
	}

	.card-grid {
		grid-template-columns: 1fr;
	}
}
</style>