---
/* @ts-nocheck */

import { createClient } from '@supabase/supabase-js'

const supabase = createClient(
	'https://vvdrdzonanhxygaiviid.supabase.co',
	'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ2ZHJkem9uYW5oeHlnYWl2aWlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkzNjU1MjEsImV4cCI6MjA5NDk0MTUyMX0.rX97Rt41Hj5SLBQe6d1WqWddShgQ0lMZzIR1q9gUQ6M'
)

const productIdFromProps = Astro.props.productId
const productIdFromUrl = Astro.url.searchParams.get('id')

const productId = productIdFromProps || productIdFromUrl

const { data: allProducts, error } = await supabase
	.from('Products')
	.select('*')

if (error) {
	console.error('Supabase products error:', error)
}

const products = allProducts || []

const product = products.find((item) => {
	return String(item.id).trim() === String(productId).trim()
})

const relatedProducts = products
	.filter((item) => String(item.id).trim() !== String(productId).trim())
	.slice(0, 3)

const productImages = [
	product?.image || '/assets/ram.png',
	product?.image || '/assets/ram.png',
	product?.image || '/assets/ram.png'
]

const isPreOrder = product?.badge === 'PRE-ORDER'
---

{
	!product && (
		<main class="missing-product">
			<h1>
				Product not found
			</h1>

			<p>
				Sorry, this product could not be loaded.
			</p>

			<p class="debug-text">
				URL id: {productId || 'No id found in URL'}
			</p>

			<p class="debug-text">
				Products found in Supabase: {products.length}
			</p>

			<p class="debug-text">
				Product ids in Supabase: {products.map((item) => item.id).join(', ')}
			</p>

			<a href="/">
				Go back home
			</a>
		</main>
	)
}

{
	product && (
		<>
			<main class="product-page">
				<section class="gallery">
					<div class="main-image">
						<img
							id="mainImage"
							src={productImages[0]}
							alt={product.title}
						/>
					</div>

					<div class="thumbnails">
						{
							productImages.map((img) => (
								<button
									class="thumbnail-btn"
									type="button"
									data-image={img}
								>
									<img src={img} alt="thumbnail" />
								</button>
							))
						}
					</div>
				</section>

				<section class="details">
					<h1>
						{product.title}
					</h1>

					<p class="price">
						{product.price} kr
					</p>

					{
						isPreOrder && (
							<p class="notice">
								Note: This item is on pre-order
								{product.release_date && (
									<span>
										{' '}and expected release date: {product.release_date}.
									</span>
								)}
							</p>
						)
					}

					<div class="actions">
						<div class="quantity-selector">
							<button id="minusBtn" type="button">
								-
							</button>

							<span id="quantityNumber">
								1
							</span>

							<button id="plusBtn" type="button">
								+
							</button>
						</div>

						<button
							id="singleAddToCart"
							class="cart-btn"
							type="button"
							data-id={product.id}
							data-title={product.title}
							data-price={product.price}
							data-image={product.image || '/assets/ram.png'}
							data-badge={product.badge || ''}
							data-release-date={product.release_date || ''}
						>
							Add to Cart
						</button>

						<button
							id="singleWishlist"
							class="wishlist-btn"
							type="button"
							data-id={product.id}
							data-title={product.title}
							data-price={product.price}
							data-image={product.image || '/assets/ram.png'}
							data-badge={product.badge || ''}
						>
							♡
						</button>
					</div>

					<div class="content-section">
						<h2>
							Description
						</h2>

						<p>
							{product.description || 'No description available yet.'}
						</p>
					</div>

					<div class="content-section">
						<h2>
							Shipping Info
						</h2>

						<p>
							Ships in 5-10 business days.
						</p>
					</div>

					<div class="content-section">
						<h2>
							Size Guide
						</h2>

						<p>
							Size information will be added soon.
						</p>
					</div>
				</section>
			</main>

			<section class="related-products">
				<h2>
					Related products
				</h2>

				<div class="related-grid">
					{
						relatedProducts.map((related) => (
							<div class="related-card">
								<div class="related-image">
									<a
										href={`/Productpage?id=${related.id}`}
										class="related-image-link"
									>
										<img
											src={related.image || '/assets/ram.png'}
											alt={related.title}
										/>
									</a>

									<button
										class="favorite related-wishlist"
										type="button"
										data-id={related.id}
										data-title={related.title}
										data-price={related.price}
										data-image={related.image || '/assets/ram.png'}
										data-badge={related.badge || ''}
									>
										♡
									</button>

									{related.badge && (
										<span class={`badge ${related.badge.toLowerCase()}`}>
											{related.badge}
										</span>
									)}
								</div>

								<div class="related-content">
									<a
										href={`/Productpage?id=${related.id}`}
										class="related-title-link"
									>
										<h3>
											{related.title}
										</h3>
									</a>

									<p class="price">
										{related.price} kr
									</p>

									<button
										class="cart-btn related-cart-btn"
										type="button"
										data-id={related.id}
										data-title={related.title}
										data-price={related.price}
										data-image={related.image || '/assets/ram.png'}
										data-badge={related.badge || ''}
										data-release-date={related.release_date || ''}
									>
										Add to Cart
									</button>
								</div>
							</div>
						))
					}
				</div>
			</section>
		</>
	)
}

<script is:inline>
	(() => {
		const mainImage =
			document.getElementById('mainImage');

		const thumbnailButtons =
			document.querySelectorAll('.thumbnail-btn');

		thumbnailButtons.forEach((button) => {
			button.addEventListener('click', () => {
				if (mainImage) {
					mainImage.src = button.dataset.image;
				}
			});
		});

		let quantity = 1;

		const quantityNumber =
			document.getElementById('quantityNumber');

		const minusBtn =
			document.getElementById('minusBtn');

		const plusBtn =
			document.getElementById('plusBtn');

		function updateQuantity() {
			if (quantityNumber) {
				quantityNumber.innerText = String(quantity);
			}
		}

		if (minusBtn) {
			minusBtn.addEventListener('click', () => {
				if (quantity > 1) {
					quantity -= 1;
					updateQuantity();
				}
			});
		}

		if (plusBtn) {
			plusBtn.addEventListener('click', () => {
				quantity += 1;
				updateQuantity();
			});
		}

		const addToCartBtn =
			document.getElementById('singleAddToCart');

		if (addToCartBtn) {
			addToCartBtn.addEventListener('click', () => {
				const product = {
					id: addToCartBtn.dataset.id,
					name: addToCartBtn.dataset.title,
					price: Number(addToCartBtn.dataset.price),
					image: addToCartBtn.dataset.image,
					badge: addToCartBtn.dataset.badge || '',
					releaseDate: addToCartBtn.dataset.releaseDate || '',
					qty: quantity
				};

				const cart = JSON.parse(
					localStorage.getItem('cart') || '[]'
				);

				const existingProduct = cart.find(
					(item) => String(item.id) === String(product.id)
				);

				if (existingProduct) {
					existingProduct.qty += quantity;
				} else {
					cart.push(product);
				}

				localStorage.setItem(
					'cart',
					JSON.stringify(cart)
				);

				addToCartBtn.innerText = 'Added ✓';

				setTimeout(() => {
					addToCartBtn.innerText = 'Add to Cart';
				}, 1000);
			});
		}

		const wishlistBtn =
			document.getElementById('singleWishlist');

		function loadSingleWishlistButton() {
			if (!wishlistBtn) return;

			const wishlist = JSON.parse(
				localStorage.getItem('wishlist') || '[]'
			);

			const alreadyExists = wishlist.find(
				(item) => String(item.id) === String(wishlistBtn.dataset.id)
			);

			if (alreadyExists) {
				wishlistBtn.innerText = '♥';
				wishlistBtn.classList.add('active');
			}
		}

		if (wishlistBtn) {
			wishlistBtn.addEventListener('click', () => {
				const product = {
					id: wishlistBtn.dataset.id,
					name: wishlistBtn.dataset.title,
					price: Number(wishlistBtn.dataset.price),
					image: wishlistBtn.dataset.image,
					badge: wishlistBtn.dataset.badge || ''
				};

				let wishlist = JSON.parse(
					localStorage.getItem('wishlist') || '[]'
				);

				const alreadyExists = wishlist.find(
					(item) => String(item.id) === String(product.id)
				);

				if (!alreadyExists) {
					wishlist.push(product);

					localStorage.setItem(
						'wishlist',
						JSON.stringify(wishlist)
					);

					wishlistBtn.innerText = '♥';
					wishlistBtn.classList.add('active');
				} else {
					wishlist = wishlist.filter(
						(item) => String(item.id) !== String(product.id)
					);

					localStorage.setItem(
						'wishlist',
						JSON.stringify(wishlist)
					);

					wishlistBtn.innerText = '♡';
					wishlistBtn.classList.remove('active');
				}
			});
		}

		const relatedCartButtons =
			document.querySelectorAll('.related-cart-btn');

		relatedCartButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const product = {
					id: button.dataset.id,
					name: button.dataset.title,
					price: Number(button.dataset.price),
					image: button.dataset.image,
					badge: button.dataset.badge || '',
					releaseDate: button.dataset.releaseDate || '',
					qty: 1
				};

				const cart = JSON.parse(
					localStorage.getItem('cart') || '[]'
				);

				const existingProduct = cart.find(
					(item) => String(item.id) === String(product.id)
				);

				if (existingProduct) {
					existingProduct.qty += 1;
				} else {
					cart.push(product);
				}

				localStorage.setItem(
					'cart',
					JSON.stringify(cart)
				);

				button.innerText = 'Added ✓';

				setTimeout(() => {
					button.innerText = 'Add to Cart';
				}, 1000);
			});
		});

		const relatedWishlistButtons =
			document.querySelectorAll('.related-wishlist');

		function loadRelatedWishlistButtons() {
			const wishlist = JSON.parse(
				localStorage.getItem('wishlist') || '[]'
			);

			relatedWishlistButtons.forEach((button) => {
				const alreadyExists = wishlist.find(
					(item) => String(item.id) === String(button.dataset.id)
				);

				if (alreadyExists) {
					button.innerText = '♥';
					button.classList.add('active');
				}
			});
		}

		relatedWishlistButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const product = {
					id: button.dataset.id,
					name: button.dataset.title,
					price: Number(button.dataset.price),
					image: button.dataset.image,
					badge: button.dataset.badge || ''
				};

				let wishlist = JSON.parse(
					localStorage.getItem('wishlist') || '[]'
				);

				const alreadyExists = wishlist.find(
					(item) => String(item.id) === String(product.id)
				);

				if (!alreadyExists) {
					wishlist.push(product);

					localStorage.setItem(
						'wishlist',
						JSON.stringify(wishlist)
					);

					button.innerText = '♥';
					button.classList.add('active');
				} else {
					wishlist = wishlist.filter(
						(item) => String(item.id) !== String(product.id)
					);

					localStorage.setItem(
						'wishlist',
						JSON.stringify(wishlist)
					);

					button.innerText = '♡';
					button.classList.remove('active');
				}
			});
		});

		loadSingleWishlistButton();
		loadRelatedWishlistButtons();
	})();
</script>

<style>
:root {
	--pink: #ec4899;
	--light-pink: #f9a8d4;
	--purple: #4b1d59;
	--soft-purple: #6b4b74;
	--bg: #f8f4f7;
	--white: #ffffff;
	--border: #f1d4e5;
}

body {
	background: var(--bg);
	color: var(--purple);
}

/* MISSING PRODUCT */

.missing-product {
	min-height: 60vh;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 1rem;
	text-align: center;
	padding: 4rem 2rem;
}

.missing-product h1 {
	color: var(--purple);
}

.missing-product a {
	color: white;
	background: var(--pink);
	padding: 1rem 2rem;
	border-radius: 999px;
	text-decoration: none;
}

.debug-text {
	font-size: 0.95rem;
	color: var(--purple);
}

/* PAGE */

.product-page {
	max-width: 1400px;
	margin: 0 auto;
	padding: 3rem 2rem;
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 5rem;
	align-items: start;
}

/* GALLERY */

.gallery {
	display: flex;
	flex-direction: column;
	gap: 1rem;
}

.main-image {
	width: 100%;
	background: #efc9cb;
	border-radius: 24px;
	overflow: hidden;
	padding: 1rem;
	box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
}

.main-image img {
	width: 100%;
	display: block;
	object-fit: contain;
}

.thumbnails {
	display: flex;
	gap: 1rem;
}

.thumbnail-btn {
	border: none;
	background: transparent;
	cursor: pointer;
	transition: 0.2s ease;
}

.thumbnail-btn img {
	width: 85px;
	height: 85px;
	object-fit: cover;
	border-radius: 14px;
	border: 2px solid transparent;
}

.thumbnail-btn:hover img {
	border-color: var(--pink);
	transform: translateY(-2px);
}

/* DETAILS */

.details {
	display: flex;
	flex-direction: column;
	gap: 1.5rem;
}

.details h1 {
	font-size: 2.5rem;
	line-height: 1.2;
	color: var(--purple);
}

.price {
	font-size: 2rem;
	font-weight: 700;
}

.notice {
	color: #e11d48;
	font-weight: 600;
	font-size: 0.95rem;
}

/* ACTIONS */

.actions {
	display: flex;
	align-items: center;
	gap: 1rem;
	margin-top: 2rem;
	flex-wrap: wrap;
}

/* QUANTITY */

.quantity-selector {
	display: flex;
	align-items: center;
	background: var(--pink);
	border-radius: 999px;
	overflow: hidden;
}

.quantity-selector button {
	width: 55px;
	height: 55px;
	border: none;
	background: transparent;
	color: white;
	font-size: 1.5rem;
	cursor: pointer;
	transition: 0.2s ease;
}

.quantity-selector button:hover {
	background: rgba(255, 255, 255, 0.15);
}

.quantity-selector span {
	width: 50px;
	text-align: center;
	color: white;
	font-weight: 700;
	font-size: 1rem;
}

/* BUTTONS */

.cart-btn {
	border: none;
	background: var(--pink);
	color: white;
	padding: 1rem 3rem;
	border-radius: 999px;
	font-size: 1rem;
	font-weight: 600;
	cursor: pointer;
	transition: 0.25s ease;
	box-shadow: 0 8px 20px rgba(236, 72, 153, 0.3);
}

.cart-btn:hover {
	transform: translateY(-2px);
	opacity: 0.95;
}

.wishlist-btn {
	width: 60px;
	height: 60px;
	border-radius: 50%;
	border: 2px solid var(--light-pink);
	background: white;
	color: var(--pink);
	font-size: 1.5rem;
	cursor: pointer;
	transition: 0.25s ease;
}

.wishlist-btn:hover,
.wishlist-btn.active {
	background: var(--pink);
	color: white;
}

/* INFO SECTIONS */

.content-section {
	border-top: 1px solid var(--border);
	padding-top: 2rem;
	margin-top: 1rem;
}

.content-section h2 {
	font-size: 1.6rem;
	margin-bottom: 1rem;
	color: var(--purple);
}

.content-section p {
	line-height: 1.8;
	color: var(--soft-purple);
	font-size: 1rem;
}

/* RELATED */

.related-products {
	padding: 5rem 2rem;
	max-width: 1400px;
	margin: 0 auto;
}

.related-products h2 {
	text-align: center;
	font-size: 2rem;
	margin-bottom: 3rem;
	color: var(--purple);
}

.related-grid {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 2rem;
}

.related-card {
	display: flex;
	flex-direction: column;
}

.related-image {
	position: relative;
	background: #efc9cb;
	border-radius: 20px;
	padding: 2rem;
	aspect-ratio: 1 / 1;

	display: flex;
	align-items: center;
	justify-content: center;

	overflow: hidden;
}

.related-image-link {
	width: 100%;
	height: 100%;

	display: flex;
	align-items: center;
	justify-content: center;

	text-decoration: none;
	color: inherit;
}

.related-image img {
	width: 100%;
	height: 100%;
	object-fit: contain;
	display: block;
}

.favorite {
	position: absolute;
	top: 1rem;
	right: 1rem;

	width: 50px;
	height: 50px;

	border-radius: 50%;
	border: none;

	background: white;
	color: var(--pink);

	font-size: 1.5rem;
	cursor: pointer;
	z-index: 5;
}

.favorite.active {
	background: var(--pink);
	color: white;
}

.badge {
	position: absolute;
	left: 1.25rem;
	bottom: 1.25rem;

	color: white;

	padding: 1rem 2rem;
	border-radius: 14px;

	font-weight: bold;
	font-size: 1rem;

	z-index: 4;
}

.badge.new {
	background: #8d5bc5;
}

.badge.sale {
	background: #f4c542;
	color: #4c2366;
}

.badge.pre-order {
	background: #ff5ca8;
}

.related-content {
	padding-top: 1rem;
}

.related-title-link {
	text-decoration: none;
	color: inherit;
}

.related-title-link h3 {
	font-size: 1rem;
	color: #4c2366;
	margin-bottom: 0.5rem;
	cursor: pointer;
}

.related-title-link h3:hover {
	color: var(--pink);
}

.related-content .price {
	font-size: 1.3rem;
	font-weight: 700;
	color: #4c2366;
	margin-bottom: 1rem;
}

.related-cart-btn {
	width: 100%;
	background: #e5a8da;
	color: #4c2366;
	box-shadow: none;
}

/* RESPONSIVE */

@media (max-width: 950px) {
	.product-page {
		grid-template-columns: 1fr;
		gap: 3rem;
	}

	.details h1 {
		font-size: 2rem;
	}

	.actions {
		flex-direction: column;
		align-items: stretch;
	}

	.cart-btn {
		width: 100%;
	}

	.wishlist-btn {
		width: 100%;
		border-radius: 999px;
	}

	.related-grid {
		grid-template-columns: repeat(2, 1fr);
	}
}

@media (max-width: 640px) {
	.related-grid {
		grid-template-columns: 1fr;
	}
}
</style>