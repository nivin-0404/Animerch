---
const product = {
  title: 'Re:ZERO -Starting Life in Another World- Ram Melty Princess Palm Size Figure',

  price: 156.99,

  releaseDate: '1/1/2027',

  images: [
    '/assets/ram.png',
    '/assets/ram.png',
    '/assets/ram.png',
  ],

  description: `
    Ram is ready to claim her spot in your collection with this Melty Princess Palm Size Figure from Re:ZERO -Starting Life in Another World-.

    Looking every bit the regal tsundere, Ram brings charm, confidence, and just a hint of sass to your shelf.
  `,
};

---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{product.title}</title>
  </head>

  <body>
   <main class="product-page">
  <section class="gallery">
    <div class="main-image">
      <img
        id="mainImage"
        src={product.images[0]}
        alt={product.title}
      />
    </div>

    <div class="thumbnails">
      {
        product.images.map((img) => (
          <button
            class="thumbnail-btn"
            data-image={img}
          >
            <img src={img} alt="thumbnail" />
          </button>
        ))
      }
    </div>
  </section>

  <section class="details">
    <h1>{product.title}</h1>

    <p class="price">
      ${product.price}
    </p>

    <p class="notice">
      Note: This item is on pre-order and is expected release
      date: {product.releaseDate}.
    </p>

    <div class="actions">
      <div class="quantity-selector">
        <button>-</button>
        <span>1</span>
        <button>+</button>
      </div>

      <button class="cart-btn">
        Add to Cart
      </button>

      <button class="wishlist-btn">
        ♡
      </button>
    </div>

    <div class="content-section">
      <h2>Description</h2>
      <p>{product.description}</p>
    </div>

    <div class="content-section">
      <h2>Shipping Info</h2>

      <p>
        Ships in 5-10 business days after release.
      </p>
    </div>

    <div class="content-section">
      <h2>Size Guide</h2>

      <p>Approximately 9 cm tall.</p>
    </div>
  </section>
</main>

<section class="related-products">
	<h2>Related products</h2>

	<div class="related-grid">
		<div class="related-card">
			<div class="related-image">
				<img
					src="/assets/ram.png"
					alt="Anime Figure"
				/>

				<button class="favorite">
					♡
				</button>
			</div>

			<div class="related-content">
				<h3>
					Lorem ipsum dolor sit amet
				</h3>

				<p class="price">
					29.99 $
				</p>

				<button class="cart-btn">
					Add to Cart
				</button>
			</div>
		</div>

		<div class="related-card">
			<div class="related-image">
				<img
					src="/assets/ram.png"
					alt="Anime Figure"
				/>

				<button class="favorite">
					♡
				</button>

				<span class="badge sale">
					SALE
				</span>
			</div>

			<div class="related-content">
				<h3>
					Lorem ipsum dolor sit amet
				</h3>

				<p class="price">
					29.99 $
				</p>

				<button class="cart-btn">
					Add to Cart
				</button>
			</div>
		</div>

		<div class="related-card">
			<div class="related-image">
				<img
					src="/assets/ram.png"
					alt="Anime Figure"
				/>

				<button class="favorite">
					♡
				</button>

				<span class="badge preorder">
					PRE-ORDER
				</span>
			</div>

			<div class="related-content">
				<h3>
					Lorem ipsum dolor sit amet
				</h3>

				<p class="price">
					29.99 $
				</p>

				<button class="cart-btn">
					Add to Cart
				</button>
			</div>
		</div>
	</div>
</section>

            <style>
                :root {
  --pink: #ec4899;
  --light-pink: #f9a8d4;
  --purple: #4b1d59;
  --soft-purple: #6b4b74;
  --bg: #f8f4f7;
  --white: #ffffff;
  --border: #f1d4e5;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: var(--bg);
  font-family: Inter, sans-serif;
  color: var(--purple);
}

/* PAGE */

.product-page {
  max-width: 1400px;
  margin: 0 auto;
  padding: 3rem 2rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: start;
}

/* GALLERY */

.gallery {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.main-image {
  width: 100%;
  background: #efc9cb;
  border-radius: 24px;
  overflow: hidden;
  padding: 1rem;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

.main-image img {
  width: 100%;
  display: block;
  object-fit: contain;
}

.thumbnails {
  display: flex;
  gap: 1rem;
}

.thumbnail-btn {
  border: none;
  background: transparent;
  cursor: pointer;
  transition: 0.2s ease;
}

.thumbnail-btn img {
  width: 85px;
  height: 85px;
  object-fit: cover;
  border-radius: 14px;
  border: 2px solid transparent;
}

.thumbnail-btn:hover img {
  border-color: var(--pink);
  transform: translateY(-2px);
}

/* DETAILS */

.details {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.details h1 {
  font-size: 2.5rem;
  line-height: 1.2;
  font-weight: 700;
  color: var(--purple);
}

.price {
  font-size: 2rem;
  font-weight: 700;
}

.notice {
  color: #e11d48;
  font-weight: 600;
  font-size: 0.95rem;
}

/* ACTIONS */

.actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-top: 2rem;
  flex-wrap: wrap;
}

/* QUANTITY */

.quantity-selector {
  display: flex;
  align-items: center;
  background: var(--pink);
  border-radius: 999px;
  overflow: hidden;
}

.quantity-selector button {
  width: 55px;
  height: 55px;
  border: none;
  background: transparent;
  color: white;
  font-size: 1.5rem;
  cursor: pointer;
  transition: 0.2s ease;
}

.quantity-selector button:hover {
  background: rgba(255,255,255,0.15);
}

.quantity-selector span {
  width: 50px;
  text-align: center;
  color: white;
  font-weight: 700;
  font-size: 1rem;
}

/* ADD TO CART */

.cart-btn {
  border: none;
  background: var(--pink);
  color: white;
  padding: 1rem 3rem;
  border-radius: 999px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: 0.25s ease;
  box-shadow: 0 8px 20px rgba(236, 72, 153, 0.3);
}

.cart-btn:hover {
  transform: translateY(-2px);
  opacity: 0.95;
}

/* WISHLIST */

.wishlist-btn {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  border: 2px solid var(--light-pink);
  background: white;
  color: var(--pink);
  font-size: 1.5rem;
  cursor: pointer;
  transition: 0.25s ease;
}

.wishlist-btn:hover {
  background: var(--pink);
  color: white;
}

/* INFO SECTIONS */

.content-section {
  border-top: 1px solid var(--border);
  padding-top: 2rem;
  margin-top: 1rem;
}

.content-section h2 {
  font-size: 1.6rem;
  margin-bottom: 1rem;
  color: var(--purple);
}

.content-section p {
  line-height: 1.8;
  color: var(--soft-purple);
  font-size: 1rem;
}

.related-products {
	padding: 5rem 2rem;
}

.related-products h2 {
	text-align: center;
	font-size: 2rem;
	margin-bottom: 3rem;
	color: var(--purple);
}

.related-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 2rem;
}

.related-card {
	display: flex;
	flex-direction: column;
}

.related-image {
	position: relative;
	background: #efc9cb;
	border-radius: 20px;

	display: flex;
	align-items: center;
	justify-content: center;

	overflow: hidden;
}

.related-image img {
	width: 72%;
	object-fit: contain;
}

.favorite {
	position: absolute;
	top: 1rem;
	right: 1rem;

	width: 50px;
	height: 50px;

	border-radius: 50%;
	border: none;

	background: white;
	color: var(--pink);

	font-size: 1.5rem;
	cursor: pointer;
}

.badge {
	position: absolute;
	left: 1rem;
	bottom: 1rem;

	padding: 0.8rem 1.5rem;
	border-radius: 10px;

	color: white;
	font-weight: bold;
	font-size: 0.9rem;
}

.sale {
	background: #f3c93c;
}

.preorder {
	background: var(--pink);
}

.related-content {
	padding-top: 1rem;
}

.related-content h3 {
	font-size: 1rem;
	margin-bottom: 0.5rem;
	color: var(--purple);
}

.related-content .price {
	font-size: 1.2rem;
	margin-bottom: 1rem;
}

.related-content .cart-btn {
	width: 100%;
}

/* RESPONSIVE */

@media (max-width: 950px) {
  .product-page {
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .details h1 {
    font-size: 2rem;
  }

  .actions {
    flex-direction: column;
    align-items: stretch;
  }

  .cart-btn {
    width: 100%;
  }

  .wishlist-btn {
    width: 100%;
    border-radius: 999px;
  }
}
            </style>

