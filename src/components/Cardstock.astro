---
import { createClient } from '@supabase/supabase-js'

const supabase = createClient(
  'https://vvdrdzonanhxygaiviid.supabase.co',
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ2ZHJkem9uYW5oeHlnYWl2aWlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkzNjU1MjEsImV4cCI6MjA5NDk0MTUyMX0.rX97Rt41Hj5SLBQe6d1WqWddShgQ0lMZzIR1q9gUQ6M'
)

const { data: products, error } = await supabase
  .from('Products')
  .select('*')

const filteredProducts = products?.filter((p) => {
  return p.badge === 'SALE' || !p.badge
})

console.log('PRODUCTS:', products)
console.log('ERROR:', error)
---

<section class="featured">
  <div class="section-header">
    <h2>In Stock</h2>
    <a href="/">Shop more ›</a>
  </div>

  <div class="card-grid">
{filteredProducts?.map((product) => (
      <div class="card">
        <div class="card-image">
          <img
            src={product.image || '/assets/ram.png'}
            alt={product.title}
          />

          <button class="favorite">♡</button>

          {product.badge && (
            <span class="badge">{product.badge}</span>
          )}
        </div>

        <div class="card-content">
          <h3>{product.title}</h3>

          <p class="price">{product.price} $</p>

          <button class="cart-btn">Add to Cart</button>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
.featured {
  padding: 5rem;
  background: #f5f5f5;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
}

.section-header h2 {
  font-size: 2rem;
  color: #4c2366;
  margin: 0;
}

.section-header a {
  text-decoration: none;
  color: #4c2366;
  font-size: 1rem;
}

.card-grid {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 2rem;
}

.card {
  display: flex;
  flex-direction: column;
}

.card-image {
	position: relative;
	background: #efcfc8;
	border-radius: 20px;
	padding: 2rem;

	aspect-ratio: 1 / 1;

	display: flex;
	align-items: center;
	justify-content: center;

	overflow: hidden;
}

.card-image img {
	width: 100%;
	height: 100%;
	object-fit: contain;
	display: block;
}


.favorite {
  position: absolute;
  top: 1rem;
  right: 1rem;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  border: none;
  background: white;
  font-size: 1.5rem;
  color: #ef4f96;
  cursor: pointer;
}

.badge {
  position: absolute;
  left: 1.25rem;
  bottom: 1.25rem;
  background: #8d5bc5;
  color: white;
  padding: 1rem 2rem;
  border-radius: 14px;
  font-weight: bold;
  font-size: 1rem;
}

.card-content {
  padding-top: 1rem;
}

.card-content h3 {
  font-size: 1.1rem;
  color: #5a2b75;
  margin: 0 0 0.5rem;
  font-weight: 500;
}

.price {
  font-size: 1.5rem;
  color: #5a2b75;
  margin-bottom: 1.25rem;
}

.cart-btn {
  width: 100%;
  padding: 1rem;
  border: none;
  border-radius: 999px;
  background: #e5a8da;
  color: #4c2366;
  font-size: 1rem;
  cursor: pointer;
  transition: 0.2s ease;
}

.cart-btn:hover {
  transform: translateY(-2px);
  opacity: 0.9;
}

@media (max-width: 1100px) {
  .card-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  .card-grid {
    grid-template-columns: 1fr;
  }
}
</style>