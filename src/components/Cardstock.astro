---
/* @ts-nocheck */

import '../style/global.css';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
	'https://vvdrdzonanhxygaiviid.supabase.co',
	'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ2ZHJkem9uYW5oeHlnYWl2aWlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkzNjU1MjEsImV4cCI6MjA5NDk0MTUyMX0.rX97Rt41Hj5SLBQe6d1WqWddShgQ0lMZzIR1q9gUQ6M'
);

const { data: products, error } = await supabase
	.from('Products')
	.select('*');

if (error) {
	console.error('Supabase error:', error);
}

function getProductImage(product: any) {
	return [
		product.image,
		product.image2,
		product.image3,
		product.image4,
		product.image5,
		product.image_2,
		product.image_3,
		product.image_4,
		product.image_5
	]
		.filter(Boolean)
		.flatMap((value) =>
			String(value)
				.split(/\n|,|\s+/)
				.map((url) => url.trim())
				.filter((url) => url.startsWith('http'))
		)[0] || '/assets/ram.png';
}

const filteredProducts = products?.filter((product) => {
	return product.badge === 'SALE' || !product.badge;
});
---

<section class="featured in-stock-section">
	<div class="section-header">
		<h2 data-i18n="inStock">
			In Stock
		</h2>

		<a href="/Collectionspage" data-i18n="shopMore">
			Shop more ›
		</a>
	</div>

	<div class="card-grid">
		{
			filteredProducts?.slice(0, 3).map((product: any) => {
				const image = getProductImage(product);

				return (
					<div class="card">
						<div class="card-image">
							<a
								href={`/Productpage?id=${product.id}`}
								class="product-image-link"
							>
								<img
									src={image}
									alt={product.title}
								/>
							</a>

							<button
								class="favorite in-stock-wishlist"
								type="button"
								data-id={product.id}
								data-title={product.title}
								data-price={product.price}
								data-image={image}
								data-badge={product.badge || ''}
							>
								♡
							</button>

							{product.badge && (
								<span class={`badge ${product.badge.toLowerCase()}`}>
									{product.badge}
								</span>
							)}
						</div>

						<div class="card-content">
							<a
								href={`/Productpage?id=${product.id}`}
								class="product-title-link"
							>
								<h3>
									{product.title}
								</h3>
							</a>

							<p class="price">
								{product.price} kr
							</p>

							<button
								class="cart-btn in-stock-cart"
								type="button"
								data-id={product.id}
								data-title={product.title}
								data-price={product.price}
								data-image={image}
								data-badge={product.badge || ''}
								data-release-date={product.release_date || ''}
								data-i18n="addToCart"
							>
								Add to Cart
							</button>
						</div>
					</div>
				);
			})
		}
	</div>
</section>

<script is:inline>
	(() => {
		const cartButtons = document.querySelectorAll('.in-stock-cart');
		const wishlistButtons = document.querySelectorAll('.in-stock-wishlist');

		function getCart() {
			return JSON.parse(localStorage.getItem('cart') || '[]');
		}

		function saveCart(cart) {
			localStorage.setItem('cart', JSON.stringify(cart));
		}

		function getWishlist() {
			return JSON.parse(localStorage.getItem('wishlist') || '[]');
		}

		function saveWishlist(wishlist) {
			localStorage.setItem('wishlist', JSON.stringify(wishlist));
		}

		function loadWishlistState() {
			const wishlist = getWishlist();

			wishlistButtons.forEach((button) => {
				const productId = button.dataset.id;

				const alreadyExists = wishlist.find(
					(item) => String(item.id) === String(productId)
				);

				if (alreadyExists) {
					button.innerText = '♥';
					button.classList.add('active');
				}
			});
		}

		cartButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const product = {
					id: button.dataset.id,
					name: button.dataset.title,
					price: Number(button.dataset.price),
					image: button.dataset.image,
					badge: button.dataset.badge || '',
					releaseDate: button.dataset.releaseDate || '',
					qty: 1
				};

				const cart = getCart();

				const existingProduct = cart.find(
					(item) => String(item.id) === String(product.id)
				);

				if (existingProduct) {
					existingProduct.qty += 1;
				} else {
					cart.push(product);
				}

				saveCart(cart);

				button.innerText = 'Added ✓';

				setTimeout(() => {
					button.innerText = 'Add to Cart';
				}, 1000);
			});
		});

		wishlistButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const product = {
					id: button.dataset.id,
					name: button.dataset.title,
					price: Number(button.dataset.price),
					image: button.dataset.image,
					badge: button.dataset.badge || ''
				};

				let wishlist = getWishlist();

				const alreadyExists = wishlist.find(
					(item) => String(item.id) === String(product.id)
				);

				if (!alreadyExists) {
					wishlist.push(product);

					button.innerText = '♥';
					button.classList.add('active');
				} else {
					wishlist = wishlist.filter(
						(item) => String(item.id) !== String(product.id)
					);

					button.innerText = '♡';
					button.classList.remove('active');
				}

				saveWishlist(wishlist);
			});
		});

		loadWishlistState();
	})();
</script>

<style>
.featured {
	width: 100%;
	padding: 5rem;
	background: #f5f5f5;
}

/* SECTION HEADER */

.section-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;

	margin-bottom: 2rem;
}

.section-header h2 {
	color: #4c2366;
	font-size: 2rem;
}

.section-header a {
	color: #4c2366;

	text-decoration: none;
	font-weight: 700;
	white-space: nowrap;
}

/* PRODUCT GRID */

.card-grid {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 2rem;
}

.card {
	width: 100%;
	min-width: 0;
}

.card-image {
	position: relative;

	aspect-ratio: 1 / 1;

	display: flex;
	align-items: center;
	justify-content: center;

	padding: 2rem;

	background: #efcfc8;
	border-radius: 20px;

	overflow: hidden;
}

.product-image-link {
	width: 100%;
	height: 100%;

	display: flex;
	align-items: center;
	justify-content: center;

	color: inherit;
	text-decoration: none;
}

.card-image img {
	width: 100%;
	height: 100%;

	display: block;
	object-fit: contain;
}

/* FAVORITE BUTTON */

.favorite {
	position: absolute;
	top: 1rem;
	right: 1rem;
	z-index: 5;

	width: 50px;
	height: 50px;

	display: flex;
	align-items: center;
	justify-content: center;

	border: none;
	border-radius: 50%;

	background: white;
	color: #ef4f96;

	font-size: 1.5rem;
	line-height: 1;

	cursor: pointer;
}

.favorite.active {
	background: #ef4f96;
	color: white;
}

/* BADGES */

.badge {
	position: absolute;
	left: 1.25rem;
	bottom: 1.25rem;
	z-index: 4;

	padding: 1rem 2rem;

	border-radius: 14px;

	color: white;

	font-size: 1rem;
	font-weight: bold;
}

.badge.new {
	background: #8d5bc5;
}

.badge.sale {
	background: #f4c542;
	color: #4c2366;
}

.badge.pre-order {
	background: #ff5ca8;
}

/* CARD CONTENT */

.card-content {
	padding-top: 1rem;
}

.product-title-link {
	color: inherit;
	text-decoration: none;
}

.product-title-link h3 {
	min-height: 2.8rem;
	margin-bottom: 0.5rem;

	color: #4c2366;

	font-size: 1rem;
	line-height: 1.4;

	cursor: pointer;

	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
}

.product-title-link h3:hover {
	color: #ef4f96;
}

.price {
	margin-bottom: 1rem;

	color: #4c2366;

	font-size: 1.3rem;
	font-weight: 700;
}

/* CART BUTTON */

.cart-btn {
	width: 100%;

	padding: 1rem;

	border: none;
	border-radius: 999px;

	background: #e5a8da;
	color: #4c2366;

	font-size: 1rem;
	font-weight: 700;

	cursor: pointer;
	transition: 0.2s ease;
}

.cart-btn:hover {
	transform: translateY(-2px);
	opacity: 0.9;
}

/* TABLET */

@media (max-width: 1024px) {
	.featured {
		padding: 4rem 2rem;
	}

	.card-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}
}

/* MOBILE */

@media (max-width: 640px) {
	.featured {
		padding: 3rem 1rem;
	}

	.section-header {
		align-items: flex-end;
		margin-bottom: 1.5rem;
	}

	.section-header h2 {
		font-size: 1.6rem;
	}

	.section-header a {
		font-size: 0.9rem;
	}

	.card-grid {
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.card {
		max-width: 420px;
		margin: 0 auto;
	}

	.card-image {
		padding: 1.5rem;
		border-radius: 18px;
	}

	.favorite {
		top: 0.8rem;
		right: 0.8rem;

		width: 42px;
		height: 42px;

		font-size: 1.25rem;
	}

	.badge {
		left: 0.9rem;
		bottom: 0.9rem;

		padding: 0.65rem 1.2rem;

		border-radius: 12px;

		font-size: 0.8rem;
	}

	.card-content {
		padding-top: 0.8rem;
	}

	.product-title-link h3 {
		min-height: auto;
		font-size: 0.95rem;
	}

	.price {
		margin-bottom: 0.8rem;
		font-size: 1.15rem;
	}

	.cart-btn {
		padding: 0.85rem 1rem;
		font-size: 0.95rem;
	}
}

/* SMALL MOBILE */

@media (max-width: 390px) {
	.featured {
		padding: 2.5rem 0.8rem;
	}

	.section-header h2 {
		font-size: 1.4rem;
	}

	.section-header a {
		font-size: 0.85rem;
	}

	.card-image {
		padding: 1.2rem;
	}

	.favorite {
		width: 38px;
		height: 38px;
		font-size: 1.15rem;
	}

	.badge {
		padding: 0.55rem 1rem;
		font-size: 0.75rem;
	}

	.cart-btn {
		padding: 0.8rem;
	}
}
</style>