---
/* @ts-nocheck */

import { createClient }
	from '@supabase/supabase-js'

const supabase =
	createClient(
		'https://vvdrdzonanhxygaiviid.supabase.co',
		'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ2ZHJkem9uYW5oeHlnYWl2aWlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkzNjU1MjEsImV4cCI6MjA5NDk0MTUyMX0.rX97Rt41Hj5SLBQe6d1WqWddShgQ0lMZzIR1q9gUQ6M'
	)

const { data: products, error } =
	await supabase
		.from('Products')
		.select('*')
---

<section class="featured">

	<div class="section-header">

		<h2>New Featured</h2>

		<a href="/Collectionspage">
			Shop more ›
		</a>

	</div>

	<div class="card-grid">

		{
products?.slice(0, 3).map((product: any) => (

				<div class="card">

					<div class="card-image">

						<img
							src={product.image}
							alt={product.title}
						/>

						<button class="favorite">
							♡
						</button>

						{
							product.badge && (
								<span class="badge">
									{product.badge}
								</span>
							)
						}

					</div>

					<div class="card-content">

						<h3>
							{product.title}
						</h3>

						<p class="price">
							{product.price}kr
						</p>

						<button class="cart-btn">
							Add to Cart
						</button>

					</div>

				</div>

			))
		}

	</div>

</section>

<style>
.featured {
	padding: 5rem;
	background: #f5f5f5;
}

.section-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 2rem;
}

.section-header h2 {
	font-size: 2rem;
	color: #4c2366;
}

.section-header a {
	text-decoration: none;
	color: #4c2366;
}

.card-grid {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 2rem;
}

.card-image {
	position: relative;
	background: #efcfc8;
	border-radius: 20px;
	padding: 2rem;

	aspect-ratio: 1 / 1;

	display: flex;
	align-items: center;
	justify-content: center;

	overflow: hidden;
}

.card-image img {
	width: 100%;
	height: 100%;
	object-fit: contain;
	display: block;
}

.favorite {
	position: absolute;
	top: 1rem;
	right: 1rem;

	width: 50px;
	height: 50px;

	border-radius: 50%;
	border: none;

	background: white;
	color: #ef4f96;

	font-size: 1.5rem;
	cursor: pointer;
}

.badge {
	position: absolute;
	left: 1rem;
	bottom: 1rem;

	background: #8d5bc5;
	color: white;

	padding: 0.8rem 1.5rem;

	border-radius: 12px;

	font-weight: bold;
}

.card-content {
	padding-top: 1rem;
}

.card-content h3 {
	font-size: 1rem;
	color: #4c2366;
	margin-bottom: 0.5rem;
}

.price {
	font-size: 1.3rem;
	font-weight: 700;
	color: #4c2366;

	margin-bottom: 1rem;
}

.cart-btn {
	width: 100%;

	padding: 1rem;

	border: none;
	border-radius: 999px;

	background: #e5a8da;
	color: #4c2366;

	cursor: pointer;
}

@media (max-width: 1024px) {
	.card-grid {
		grid-template-columns: repeat(2, 1fr);
	}
}

@media (max-width: 640px) {
	.card-grid {
		grid-template-columns: 1fr;
	}
}
</style>