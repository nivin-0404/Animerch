---
const title = 'My Wishlist';

import '../style/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>

		<title>{title}</title>
	</head>

	<body>
		<Header />

		<main class="wishlist-page">
			<img
				class="banner"
				src="/assets/animerchbanner.png"
				alt="Animerch banner"
			/>

			<section class="wishlist-content">
				<h1>
					Favorites
				</h1>

				<div id="wishlistGrid" class="wishlist-grid"></div>
			</section>
		</main>

		<Footer />

		<script is:inline>
			const wishlistGrid = document.getElementById('wishlistGrid');

			let wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');

			function saveWishlist() {
				localStorage.setItem('wishlist', JSON.stringify(wishlist));
			}

			function getCart() {
				return JSON.parse(localStorage.getItem('cart') || '[]');
			}

			function saveCart(cart) {
				localStorage.setItem('cart', JSON.stringify(cart));
			}

			function renderWishlist() {
				if (!wishlistGrid) return;

				wishlistGrid.innerHTML = '';

				if (wishlist.length === 0) {
					wishlistGrid.innerHTML = `
						<p class="empty">
							Your wishlist is empty.
						</p>
					`;

					return;
				}

				wishlist.forEach((item, index) => {
					const card = document.createElement('div');

					card.className = 'wishlist-card';

					card.innerHTML = `
						<div class="wishlist-image">
							<img src="${item.image}" alt="${item.name}" />

							<button
								class="remove-wishlist"
								type="button"
								data-index="${index}"
								aria-label="Remove from wishlist"
							>
								×
							</button>
						</div>

						<h3>${item.name}</h3>

						<p>${item.price} kr</p>

						<button
							class="cart-btn"
							type="button"
							data-index="${index}"
						>
							Add to Cart
						</button>
					`;

					wishlistGrid.appendChild(card);
				});

				setupButtons();
			}

			function setupButtons() {
				document.querySelectorAll('.remove-wishlist').forEach((button) => {
					button.addEventListener('click', () => {
						const index = Number(button.dataset.index);

						wishlist.splice(index, 1);

						saveWishlist();
						renderWishlist();
					});
				});

				document.querySelectorAll('.cart-btn').forEach((button) => {
					button.addEventListener('click', () => {
						const index = Number(button.dataset.index);
						const item = wishlist[index];

						let cart = getCart();

						const existingProduct = cart.find(
							(product) => String(product.id) === String(item.id)
						);

						if (existingProduct) {
							existingProduct.qty += 1;
						} else {
							cart.push({
								id: item.id,
								name: item.name,
								price: Number(item.price),
								image: item.image,
								badge: item.badge || '',
								qty: 1
							});
						}

						saveCart(cart);

						button.innerText = 'Added ✓';

						setTimeout(() => {
							button.innerText = 'Add to Cart';
						}, 1000);
					});
				});
			}

			renderWishlist();
		</script>
	</body>
</html>

<style is:global>
:root {
	--pink: #ef4f96;
	--purple: #4c2366;
	--light-pink: #f5baea;
}

* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}

body {
	background: white;
	color: var(--purple);
	font-family: Inter, sans-serif;
}

/* WISHLIST PAGE */

.wishlist-page {
	width: 100%;
	min-height: 100vh;
	background: white;
}

.banner {
	width: 100%;
	height: 720px;

	display: block;
	object-fit: cover;
}

.wishlist-content {
	width: 100%;
	max-width: 1200px;

	margin: 0 auto;
	padding: 3rem 4rem 6rem;
}

.wishlist-content h1 {
	margin-bottom: 3rem;

	color: var(--purple);

	text-align: center;
	font-size: 1.5rem;
	font-weight: 800;
}

/* WISHLIST GRID */

.wishlist-grid {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 2rem;
}

.wishlist-card {
	width: 100%;
	min-width: 0;

	display: flex;
	flex-direction: column;
}

.wishlist-image {
	position: relative;

	width: 100%;
	aspect-ratio: 1 / 1;

	display: flex;
	align-items: center;
	justify-content: center;

	background: var(--light-pink);
	border-radius: 20px;

	overflow: hidden;
}

.wishlist-image img {
	width: 100%;
	height: 100%;

	padding: 1rem;

	display: block;
	object-fit: contain;
}

/* REMOVE BUTTON */

.remove-wishlist {
	position: absolute;
	top: 1rem;
	right: 1rem;
	z-index: 5;

	width: 45px;
	height: 45px;

	display: flex;
	align-items: center;
	justify-content: center;

	border: none;
	border-radius: 50%;

	background: white;
	color: var(--pink);

	font-size: 1.4rem;
	line-height: 1;

	cursor: pointer;
	transition: 0.2s ease;
}

.remove-wishlist:hover {
	background: var(--pink);
	color: white;
	transform: scale(1.05);
}

/* CARD CONTENT */

.wishlist-card h3 {
	min-height: 2.8rem;

	margin-top: 1rem;
	margin-bottom: 0.5rem;

	color: var(--purple);

	font-size: 1rem;
	font-weight: 500;
	line-height: 1.4;

	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
}

.wishlist-card p {
	margin-bottom: 1rem;

	color: var(--purple);

	font-size: 1.2rem;
	font-weight: 700;
}

/* CART BUTTON */

.cart-btn {
	width: 100%;

	padding: 1rem;

	border: none;
	border-radius: 999px;

	background: #e5a8da;
	color: var(--purple);

	font-size: 1rem;
	font-weight: 600;

	cursor: pointer;
	transition: 0.2s ease;
}

.cart-btn:hover {
	transform: translateY(-2px);
	opacity: 0.9;
}

/* EMPTY */

.empty {
	grid-column: 1 / -1;

	padding: 3rem 0;

	color: var(--purple);

	text-align: center;
	font-size: 1.1rem;
}

/* TABLET */

@media (max-width: 900px) {
	.banner {
		height: 300px;
	}

	.wishlist-content {
		padding: 3rem 2rem 5rem;
	}

	.wishlist-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}
}

/* MOBILE */

@media (max-width: 600px) {
	.banner {
		height: 190px;
	}

	.wishlist-content {
		padding: 2.5rem 1rem 4rem;
	}

	.wishlist-content h1 {
		margin-bottom: 2rem;
		font-size: 1.4rem;
	}

	.wishlist-grid {
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.wishlist-card {
		max-width: 420px;
		margin: 0 auto;
	}

	.wishlist-image {
		border-radius: 18px;
	}

	.wishlist-image img {
		padding: 1.2rem;
	}

	.remove-wishlist {
		top: 0.8rem;
		right: 0.8rem;

		width: 42px;
		height: 42px;

		font-size: 1.25rem;
	}

	.wishlist-card h3 {
		min-height: auto;
		font-size: 0.95rem;
	}

	.wishlist-card p {
		margin-bottom: 0.8rem;
		font-size: 1.15rem;
	}

	.cart-btn {
		padding: 0.85rem 1rem;
		font-size: 0.95rem;
	}

	.empty {
		padding: 2rem 0;
		font-size: 1rem;
	}
}

/* SMALL MOBILE */

@media (max-width: 390px) {
	.banner {
		height: 160px;
	}

	.wishlist-content {
		padding: 2rem 0.8rem 3.5rem;
	}

	.wishlist-content h1 {
		font-size: 1.25rem;
	}

	.wishlist-image img {
		padding: 1rem;
	}

	.remove-wishlist {
		width: 38px;
		height: 38px;
		font-size: 1.15rem;
	}

	.cart-btn {
		padding: 0.8rem;
	}
}
</style>