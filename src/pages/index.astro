---
import Homepage from '../components/Homepage.astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Card from '../components/Cardfeature.astro';
import Stock from '../components/Cardstock.astro';
import Preorder from '../components/Cardpreorder.astro';
import Series from '../components/Series.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
		<Header />
		<img class="banner" src="/assets/animerchbanner.png" alt="banner" />
		<Card />
		<Stock />
		<Preorder />
		<Series />
		<Homepage />
				<Footer />
</Layout>


<style>
	.banner {
		width: 100%;
		height: 50%;
	}

</style>