---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../style/global.css';
---

<Layout>
	<Header />

	<main id="productArea" class="product-page">
		<section class="gallery">
			<div class="main-image">
				<button id="prevImageBtn" class="image-arrow left" type="button">‹</button>

				<img id="mainImage" src="/assets/ram.png" alt="Product image" />

				<button id="nextImageBtn" class="image-arrow right" type="button">›</button>
			</div>

			<div id="thumbnails" class="thumbnails"></div>
		</section>

		<section class="details">
			<h1 id="productTitle">Loading product...</h1>

			<p id="productPrice" class="price"></p>

			<p id="preorderNotice" class="notice"></p>

			<div class="actions">
				<div class="quantity-selector">
					<button id="minusBtn" type="button">-</button>
					<span id="quantityNumber">1</span>
					<button id="plusBtn" type="button">+</button>
				</div>

				<button id="singleAddToCart" class="cart-btn" type="button">
					Add to Cart
				</button>

				<button id="singleWishlist" class="wishlist-btn" type="button">
					♡
				</button>
			</div>

			<div class="content-section">
				<h2>Description</h2>
				<p id="productDescription">Loading description...</p>
			</div>

			<div class="content-section">
				<h2>Shipping Info</h2>
				<p>Ships in 5-10 business days.</p>
			</div>

			<div class="content-section">
				<h2>Size Guide</h2>
				<p>Size information will be added soon.</p>
			</div>
		</section>
	</main>

	<main id="missingProduct" class="missing-product" style="display: none;">
		<h1>Product not found</h1>

		<p>Sorry, this product could not be loaded.</p>

		<p id="debugUrl" class="debug-text"></p>
		<p id="debugCount" class="debug-text"></p>
		<p id="debugIds" class="debug-text"></p>

		<a href="/">Go back home</a>
	</main>

	<section id="relatedSection" class="related-products">
		<h2>Related products</h2>
		<div id="relatedGrid" class="related-grid"></div>
	</section>

	<Footer />

	<script>
		// @ts-nocheck

		import { createClient } from '@supabase/supabase-js'

		const supabase = createClient(
			'https://vvdrdzonanhxygaiviid.supabase.co',
			'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ2ZHJkem9uYW5oeHlnYWl2aWlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkzNjU1MjEsImV4cCI6MjA5NDk0MTUyMX0.rX97Rt41Hj5SLBQe6d1WqWddShgQ0lMZzIR1q9gUQ6M'
		)

		const params = new URLSearchParams(window.location.search)
		const productId = params.get('id')

		const productArea = document.getElementById('productArea')
		const missingProduct = document.getElementById('missingProduct')
		const relatedSection = document.getElementById('relatedSection')

		const mainImage = document.getElementById('mainImage')
		const thumbnails = document.getElementById('thumbnails')

		const productTitle = document.getElementById('productTitle')
		const productPrice = document.getElementById('productPrice')
		const preorderNotice = document.getElementById('preorderNotice')
		const productDescription = document.getElementById('productDescription')

		const debugUrl = document.getElementById('debugUrl')
		const debugCount = document.getElementById('debugCount')
		const debugIds = document.getElementById('debugIds')

		const singleAddToCart = document.getElementById('singleAddToCart')
		const singleWishlist = document.getElementById('singleWishlist')

		const relatedGrid = document.getElementById('relatedGrid')

		const prevImageBtn = document.getElementById('prevImageBtn')
		const nextImageBtn = document.getElementById('nextImageBtn')

		let currentProduct = null
		let quantity = 1
		let productImages = []
		let currentImageIndex = 0

		const quantityNumber = document.getElementById('quantityNumber')
		const minusBtn = document.getElementById('minusBtn')
		const plusBtn = document.getElementById('plusBtn')

		function updateQuantity() {
			quantityNumber.innerText = String(quantity)
		}

		minusBtn.addEventListener('click', () => {
			if (quantity > 1) {
				quantity -= 1
				updateQuantity()
			}
		})

		plusBtn.addEventListener('click', () => {
			quantity += 1
			updateQuantity()
		})

		function showMissing(products) {
			productArea.style.display = 'none'
			relatedSection.style.display = 'none'
			missingProduct.style.display = 'flex'

			debugUrl.innerText = `URL id: ${productId || 'No id found in URL'}`
			debugCount.innerText = `Products found in Supabase: ${products.length}`
			debugIds.innerText = `Product ids in Supabase: ${products.map((item) => item.id).join(', ')}`
		}

		function updateMainImage(index) {
			if (!productImages.length) return

			currentImageIndex = index

			if (currentImageIndex < 0) {
				currentImageIndex = productImages.length - 1
			}

			if (currentImageIndex >= productImages.length) {
				currentImageIndex = 0
			}

			mainImage.src = productImages[currentImageIndex]

			document.querySelectorAll('.thumbnail-btn').forEach((button) => {
				button.classList.remove('active')
			})

			const activeThumbnail = document.querySelector(
				`.thumbnail-btn[data-index="${currentImageIndex}"]`
			)

			if (activeThumbnail) {
				activeThumbnail.classList.add('active')
			}
		}

		function getProductImages(product) {
			return [
				product.image,
				product.image2,
				product.image3,
				product.image4,
				product.image5,
				product.image_2,
				product.image_3,
				product.image_4,
				product.image_5
			]
				.filter(Boolean)
				.flatMap((value) => {
					return String(value)
						.split(/\n|,/)
						.map((url) => url.trim())
						.filter(Boolean)
				})
		}

		function renderProduct(product) {
			currentProduct = product

			productImages = getProductImages(product)

			if (!productImages.length) {
				productImages = ['/assets/ram.png']
			}

			currentImageIndex = 0

			productTitle.innerText = product.title || 'Untitled product'
			productPrice.innerText = `${product.price} kr`
			productDescription.innerText = product.description || 'No description available yet.'

			mainImage.src = productImages[0]
			mainImage.alt = product.title || 'Product image'

			if (product.badge === 'PRE-ORDER') {
				preorderNotice.innerText = product.release_date
					? `Note: This item is on pre-order and expected release date: ${product.release_date}.`
					: 'Note: This item is on pre-order.'
			} else {
				preorderNotice.innerText = ''
			}

			thumbnails.innerHTML = productImages
				.map((img, index) => {
					return `
						<button
							class="thumbnail-btn ${index === 0 ? 'active' : ''}"
							type="button"
							data-image="${img}"
							data-index="${index}"
						>
							<img src="${img}" alt="thumbnail" />
						</button>
					`
				})
				.join('')

			document.querySelectorAll('.thumbnail-btn').forEach((button) => {
				button.addEventListener('click', () => {
					updateMainImage(Number(button.dataset.index))
				})
			})

			loadWishlistButton()
		}

		prevImageBtn.addEventListener('click', () => {
			updateMainImage(currentImageIndex - 1)
		})

		nextImageBtn.addEventListener('click', () => {
			updateMainImage(currentImageIndex + 1)
		})

		function renderRelated(products) {
			const relatedProducts = products
				.filter((item) => String(item.id) !== String(productId))
				.slice(0, 3)

			relatedGrid.innerHTML = relatedProducts
				.map((product) => {
					const relatedImages = getProductImages(product)
					const image = relatedImages[0] || '/assets/ram.png'

					const badge = product.badge
						? `<span class="badge ${String(product.badge).toLowerCase()}">${product.badge}</span>`
						: ''

					return `
						<div class="related-card">
							<div class="related-image">
								<a href="/Productpage?id=${product.id}" class="related-image-link">
									<img src="${image}" alt="${product.title}" />
								</a>

								<button
									class="favorite related-wishlist"
									type="button"
									aria-label="Add to wishlist"
									data-id="${product.id}"
									data-title="${product.title}"
									data-price="${product.price}"
									data-image="${image}"
									data-badge="${product.badge || ''}"
								>
									♡
								</button>

								${badge}
							</div>

							<div class="related-content">
								<a href="/Productpage?id=${product.id}" class="related-title-link">
									<h3>${product.title}</h3>
								</a>

								<p class="price">${product.price} kr</p>

								<button
									class="cart-btn related-cart-btn"
									type="button"
									data-id="${product.id}"
									data-title="${product.title}"
									data-price="${product.price}"
									data-image="${image}"
									data-badge="${product.badge || ''}"
									data-release-date="${product.release_date || ''}"
								>
									Add to Cart
								</button>
							</div>
						</div>
					`
				})
				.join('')

			setupRelatedCartButtons()
			setupRelatedWishlistButtons()
		}

		function setupRelatedCartButtons() {
			document.querySelectorAll('.related-cart-btn').forEach((button) => {
				button.addEventListener('click', () => {
					const product = {
						id: button.dataset.id,
						name: button.dataset.title,
						price: Number(button.dataset.price),
						image: button.dataset.image,
						badge: button.dataset.badge || '',
						releaseDate: button.dataset.releaseDate || '',
						qty: 1
					}

					const cart = JSON.parse(localStorage.getItem('cart') || '[]')

					const existingProduct = cart.find(
						(item) => String(item.id) === String(product.id)
					)

					if (existingProduct) {
						existingProduct.qty += 1
					} else {
						cart.push(product)
					}

					localStorage.setItem('cart', JSON.stringify(cart))

					button.innerText = 'Added ✓'

					setTimeout(() => {
						button.innerText = 'Add to Cart'
					}, 1000)
				})
			})
		}

		function setupRelatedWishlistButtons() {
			const wishlistButtons = document.querySelectorAll('.related-wishlist')

			let wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]')

			wishlistButtons.forEach((button) => {
				const alreadyExists = wishlist.find(
					(item) => String(item.id) === String(button.dataset.id)
				)

				if (alreadyExists) {
					button.innerText = '♥'
					button.classList.add('active')
					button.setAttribute('aria-label', 'Remove from wishlist')
				} else {
					button.innerText = '♡'
					button.classList.remove('active')
					button.setAttribute('aria-label', 'Add to wishlist')
				}

				button.addEventListener('click', (event) => {
					event.preventDefault()
					event.stopPropagation()

					let wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]')

					const product = {
						id: button.dataset.id,
						name: button.dataset.title,
						price: Number(button.dataset.price),
						image: button.dataset.image,
						badge: button.dataset.badge || ''
					}

					const alreadyExists = wishlist.find(
						(item) => String(item.id) === String(product.id)
					)

					if (!alreadyExists) {
						wishlist.push(product)

						button.innerText = '♥'
						button.classList.add('active')
						button.setAttribute('aria-label', 'Remove from wishlist')
					} else {
						wishlist = wishlist.filter(
							(item) => String(item.id) !== String(product.id)
						)

						button.innerText = '♡'
						button.classList.remove('active')
						button.setAttribute('aria-label', 'Add to wishlist')
					}

					localStorage.setItem('wishlist', JSON.stringify(wishlist))
				})
			})
		}

		function loadWishlistButton() {
			if (!currentProduct) return

			const wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]')

			const alreadyExists = wishlist.find(
				(item) => String(item.id) === String(currentProduct.id)
			)

			if (alreadyExists) {
				singleWishlist.innerText = '♥'
				singleWishlist.classList.add('active')
			} else {
				singleWishlist.innerText = '♡'
				singleWishlist.classList.remove('active')
			}
		}

		singleAddToCart.addEventListener('click', () => {
			if (!currentProduct) return

			const product = {
				id: currentProduct.id,
				name: currentProduct.title,
				price: Number(currentProduct.price),
				image: productImages[0] || currentProduct.image || '/assets/ram.png',
				badge: currentProduct.badge || '',
				releaseDate: currentProduct.release_date || '',
				qty: quantity
			}

			const cart = JSON.parse(localStorage.getItem('cart') || '[]')

			const existingProduct = cart.find(
				(item) => String(item.id) === String(product.id)
			)

			if (existingProduct) {
				existingProduct.qty += quantity
			} else {
				cart.push(product)
			}

			localStorage.setItem('cart', JSON.stringify(cart))

			singleAddToCart.innerText = 'Added ✓'

			setTimeout(() => {
				singleAddToCart.innerText = 'Add to Cart'
			}, 1000)
		})

		singleWishlist.addEventListener('click', () => {
			if (!currentProduct) return

			const product = {
				id: currentProduct.id,
				name: currentProduct.title,
				price: Number(currentProduct.price),
				image: productImages[0] || currentProduct.image || '/assets/ram.png',
				badge: currentProduct.badge || ''
			}

			let wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]')

			const alreadyExists = wishlist.find(
				(item) => String(item.id) === String(product.id)
			)

			if (!alreadyExists) {
				wishlist.push(product)
			} else {
				wishlist = wishlist.filter(
					(item) => String(item.id) !== String(product.id)
				)
			}

			localStorage.setItem('wishlist', JSON.stringify(wishlist))
			loadWishlistButton()
		})

		async function loadProduct() {
			const { data, error } = await supabase
				.from('Products')
				.select('*')

			if (error) {
				console.error('Supabase error:', error)
				showMissing([])
				return
			}

			const products = data || []

			const product = products.find((item) => {
				return String(item.id).trim() === String(productId).trim()
			})

			if (!product) {
				showMissing(products)
				return
			}

			renderProduct(product)
			renderRelated(products)
		}

		loadProduct()
	</script>
</Layout>

<style is:global>
:root {
	--pink: #ec4899;
	--light-pink: #f9a8d4;
	--purple: #4b1d59;
	--soft-purple: #6b4b74;
	--bg: #f8f4f7;
	--white: #ffffff;
	--border: #f1d4e5;
}

body {
	background: var(--bg);
	color: var(--purple);
}

.missing-product {
	min-height: 60vh;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 1rem;
	text-align: center;
	padding: 4rem 2rem;
}

.missing-product h1 {
	color: var(--purple);
}

.missing-product a {
	color: white;
	background: var(--pink);
	padding: 1rem 2rem;
	border-radius: 999px;
	text-decoration: none;
}

.debug-text {
	font-size: 0.95rem;
	color: var(--purple);
}

.product-page {
	max-width: 1400px;
	margin: 0 auto;
	padding: 3rem 2rem;
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 5rem;
	align-items: start;
}

.gallery {
	display: flex;
	flex-direction: column;
	gap: 1rem;
}

.main-image {
	position: relative;
	width: 100%;
	background: #efc9cb;
	border-radius: 24px;
	overflow: hidden;
	padding: 1rem;
	box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
	min-height: 500px;

	display: flex;
	align-items: center;
	justify-content: center;
}

.main-image img {
	width: 100%;
	height: 100%;
	max-height: 520px;
	display: block;
	object-fit: contain;
}

.image-arrow {
	position: absolute;
	top: 50%;
	transform: translateY(-50%);
	z-index: 5;

	width: 45px;
	height: 45px;

	border: none;
	border-radius: 50%;

	background: white;
	color: var(--pink);

	font-size: 2rem;
	line-height: 1;

	cursor: pointer;
	box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
	transition: 0.2s ease;
}

.image-arrow:hover {
	background: var(--pink);
	color: white;
}

.image-arrow.left {
	left: 1rem;
}

.image-arrow.right {
	right: 1rem;
}

.thumbnails {
	display: flex;
	gap: 1rem;
	flex-wrap: wrap;
}

.thumbnail-btn {
	border: none;
	background: transparent;
	cursor: pointer;
	transition: 0.2s ease;
	border-radius: 14px;
	padding: 0;
}

.thumbnail-btn img {
	width: 85px;
	height: 85px;
	object-fit: cover;
	border-radius: 14px;
	border: 3px solid transparent;
}

.thumbnail-btn:hover img,
.thumbnail-btn.active img {
	border-color: var(--pink);
	transform: translateY(-2px);
}

.details {
	display: flex;
	flex-direction: column;
	gap: 1.5rem;
}

.details h1 {
	font-size: 2.5rem;
	line-height: 1.2;
	color: var(--purple);
}

.price {
	font-size: 2rem;
	font-weight: 700;
}

.notice {
	color: #e11d48;
	font-weight: 600;
	font-size: 0.95rem;
}

.actions {
	display: flex;
	align-items: center;
	gap: 1rem;
	margin-top: 2rem;
	flex-wrap: wrap;
}

.quantity-selector {
	display: flex;
	align-items: center;
	background: var(--pink);
	border-radius: 999px;
	overflow: hidden;
}

.quantity-selector button {
	width: 55px;
	height: 55px;
	border: none;
	background: transparent;
	color: white;
	font-size: 1.5rem;
	cursor: pointer;
	transition: 0.2s ease;
}

.quantity-selector button:hover {
	background: rgba(255, 255, 255, 0.15);
}

.quantity-selector span {
	width: 50px;
	text-align: center;
	color: white;
	font-weight: 700;
	font-size: 1rem;
}

.cart-btn {
	border: none;
	background: var(--pink);
	color: white;
	padding: 1rem 3rem;
	border-radius: 999px;
	font-size: 1rem;
	font-weight: 600;
	cursor: pointer;
	transition: 0.25s ease;
	box-shadow: 0 8px 20px rgba(236, 72, 153, 0.3);
}

.cart-btn:hover {
	transform: translateY(-2px);
	opacity: 0.95;
}

.wishlist-btn {
	width: 60px;
	height: 60px;
	border-radius: 50%;
	border: 2px solid var(--light-pink);
	background: white;
	color: var(--pink);
	font-size: 1.5rem;
	cursor: pointer;
	transition: 0.25s ease;
}

.wishlist-btn:hover,
.wishlist-btn.active {
	background: var(--pink);
	color: white;
}

.content-section {
	border-top: 1px solid var(--border);
	padding-top: 2rem;
	margin-top: 1rem;
}

.content-section h2 {
	font-size: 1.6rem;
	margin-bottom: 1rem;
	color: var(--purple);
}

.content-section p {
	line-height: 1.8;
	color: var(--soft-purple);
	font-size: 1rem;
}

.related-products {
	padding: 5rem 2rem;
	max-width: 1400px;
	margin: 0 auto;
}

.related-products h2 {
	text-align: center;
	font-size: 2rem;
	margin-bottom: 3rem;
	color: var(--purple);
}

.related-grid {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 2rem;
}

.related-card {
	display: flex;
	flex-direction: column;
}

.related-image {
	position: relative;
	background: #efc9cb;
	border-radius: 20px;
	padding: 2rem;
	aspect-ratio: 1 / 1;

	display: flex;
	align-items: center;
	justify-content: center;

	overflow: hidden;
}

.related-image-link {
	width: 100%;
	height: 100%;

	display: flex;
	align-items: center;
	justify-content: center;

	text-decoration: none;
	color: inherit;
}

.related-image img {
	width: 100%;
	height: 100%;
	object-fit: contain;
	display: block;
}

.favorite {
	position: absolute;
	top: 1rem;
	right: 1rem;

	width: 50px;
	height: 50px;

	display: flex;
	align-items: center;
	justify-content: center;

	border-radius: 50%;
	border: none;

	background: white;
	color: var(--pink);

	font-size: 1.35rem;
	font-weight: 700;
	line-height: 1;

	cursor: pointer;
	z-index: 10;

	transition: 0.2s ease;
}

.favorite:hover {
	transform: scale(1.05);
}

.favorite.active {
	background: var(--pink) !important;
	color: white !important;
}

.badge {
	position: absolute;
	left: 1.25rem;
	bottom: 1.25rem;

	color: white;

	padding: 1rem 2rem;
	border-radius: 14px;

	font-weight: bold;
	font-size: 1rem;
}

.badge.new {
	background: #8d5bc5;
}

.badge.sale {
	background: #f4c542;
	color: #4c2366;
}

.badge.pre-order {
	background: #ff5ca8;
}

.related-content {
	padding-top: 1rem;
}

.related-title-link {
	text-decoration: none;
	color: inherit;
}

.related-title-link h3 {
	font-size: 1rem;
	color: #4c2366;
	margin-bottom: 0.5rem;
	cursor: pointer;
}

.related-title-link h3:hover {
	color: var(--pink);
}

.related-content .price {
	font-size: 1.3rem;
	font-weight: 700;
	color: #4c2366;
	margin-bottom: 1rem;
}

.related-cart-btn {
	width: 100%;
	background: #e5a8da;
	color: #4c2366;
	box-shadow: none;
}

@media (max-width: 950px) {
	.product-page {
		grid-template-columns: 1fr;
		gap: 3rem;
	}

	.details h1 {
		font-size: 2rem;
	}

	.actions {
		flex-direction: column;
		align-items: stretch;
	}

	.cart-btn {
		width: 100%;
	}

